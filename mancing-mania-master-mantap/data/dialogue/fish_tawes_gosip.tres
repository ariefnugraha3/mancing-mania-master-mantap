[sub_resource type="Resource" id="Entry_2"]
script = ExtResource("2_entry")
speaker_id = &"darto"
text = "How does a fish know about that?"
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_3"]
script = ExtResource("2_entry")
speaker_id = &"tawes_gosip"
text = "Everyone knows. I made sure."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_4"]
script = ExtResource("2_entry")
speaker_id = &"darto"
text = "Great. A fish with a network."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_5"]
script = ExtResource("2_entry")
speaker_id = &"tawes_gosip"
text = "Fight me and I'll keep it quiet. Probably."
post_pause_sec = 0.4

[resource]
script = ExtResource("1_seq")
