"settings.section.privacy": "PRIVASI",
"settings.privacy.open": "PRIVASI DAN LISENSI",
"privacy.title": "PRIVASI",
"privacy.summary.1": "TIDAK PERLU AKUN",
"privacy.summary.2": "TANPA IKLAN",
"privacy.summary.3": "TANPA ANALITIK",
"privacy.summary.4": "GAME TIDAK MENGUMPULKAN DATA PRIBADI",
"privacy.summary.5": "DATA SAVE TETAP DI PERANGKAT/BROWSER INI",
"privacy.read_full": "BACA KEBIJAKAN PRIVASI LENGKAP",
"privacy.licenses": "LISENSI",
"privacy.policy.intro": "Catch and Brawl dirancang untuk dimainkan tanpa membuat akun dan tanpa mengirim data permainan ke pengembang.",
"privacy.policy.collection.title": "Pengumpulan data",
"privacy.policy.collection.body": "Game ini tidak mengumpulkan, menjual, atau membagikan informasi pribadi. Game ini tidak memakai SDK iklan, SDK analitik, SDK pelacakan, layanan lokasi, akses kamera, akses mikrofon, kontak, atau login media sosial.",
"privacy.policy.local.title": "Data save lokal",
"privacy.policy.local.body": "Progres permainan, pengaturan, rekor, progres Buku Ikan, dan progres cerita disimpan secara lokal di perangkatmu atau, untuk versi web, di penyimpanan browser. Informasi ini tidak dikirim oleh game ke server pengembang.",
"privacy.policy.web.title": "Versi web",
"privacy.policy.web.body": "Versi web di-hosting oleh platform distribusi pihak ketiga. Platform tersebut bisa memproses informasi teknis sesuai kebijakan privasinya sendiri saat mengirimkan file game. Catch and Brawl tidak menambahkan sistem analitik, iklan, atau pelacakan sendiri.",
"privacy.policy.export.title": "Ekspor dan impor save",
"privacy.policy.export.body": "Jika build web menyediakan ekspor save manual, file save hanya dibuat saat kamu memintanya. Impor membaca file yang kamu pilih secara lokal untuk memulihkan progres permainan.",
"privacy.policy.children.title": "Anak-anak dan informasi pribadi",
"privacy.policy.children.body": "Game ini tidak meminta pemain memberikan informasi pribadi dan tidak menyediakan fitur chat, konten buatan pengguna, atau akun.",
"privacy.policy.changes.title": "Perubahan kebijakan ini",
"privacy.policy.changes.body": "Jika versi mendatang menambahkan fitur yang mengubah cara data ditangani, kebijakan ini akan diperbarui sebelum versi tersebut dirilis.",
"privacy.policy.contact.title": "Kontak",
"privacy.policy.contact.body": "Untuk pertanyaan privasi atau dukungan, hubungi: [PUBLISHER SUPPORT EMAIL]",
"privacy.licenses.intro": "Dibuat dengan Godot Engine. Godot adalah perangkat lunak gratis dan open source dengan lisensi MIT:",
"privacy.licenses.components": "Godot menyertakan komponen pihak ketiga dengan lisensinya masing-masing: {list}.",
"privacy.licenses.fonts": "Teks memakai font Fredoka karya Milena Brandão dan Hafontia (Copyright 2016 The Fredoka Project Authors) dengan SIL Open Font License 1.1, serta Chewy karya Font Diner (Copyright (c) 2010 by Font Diner, Inc DBA Sideshow) dengan Apache License 2.0. Teks lengkap kedua lisensi ada di bawah:",
"settings.web_storage_note": "Versi web ini menyimpan save-mu di penyimpanan browser ini. Menghapus data situs atau penyimpanan browser akan menghapusnya.",
"fish.catfish_bruiser.name": "Lele Jagoan",
"fish.tilapia_gym_rat.name": "Nila Anak Gym",
"fish.gourami_shady.name": "Gurami Mencurigakan",
"fish.carp_golden.name": "Ikan Mas Emas",
"fish.snakehead_sergeant.name": "Sersan Gabus",
"fish.arowana_don.name": "Don Arwana",
"fish.catfish_bruiser.species": "LELE",
"fish.tilapia_gym_rat.species": "NILA",
"fish.gourami_shady.species": "GURAMI",
"fish.carp_golden.species": "IKAN MAS",
"fish.snakehead_sergeant.species": "GABUS",
"fish.arowana_don.species": "ARWANA ASIA",
"upgrade.bait.name": "Umpan Pelet Super",
"upgrade.rod.name": "Joran Serat Karbon",
"upgrade.tonic.name": "Jamu Pegal Linu",
"upgrade.coffee.name": "Kopi Tubruk",
"upgrade.charm.name": "Cincin Batu Akik",
"trash.trash_can.name": "Kaleng Karatan",
"trash.trash_sandal.name": "Sandal Jepit Sebelah",
"trash.trash_tyre.name": "Ban Purba",
"fishline.fish_catfish_bruiser.1": "Turunkan aku.",
"fishline.fish_catfish_bruiser.2": "...Hah?",
"fishline.fish_catfish_bruiser.3": "Kau tuli? Aku bilang turunkan aku!",
"fishline.fish_catfish_bruiser.4": "Ikan kok bisa ngomong?!",
"fishline.fish_catfish_bruiser.5": "Kamu sendiri kenapa bisa menganggur?",
"fishline.fish_catfish_bruiser.6": "Ayo berantem aja.",
"fishline.fish_tilapia_gym_rat.1": "KAMU BENERAN BISA NARIK?",
"fishline.fish_tilapia_gym_rat.2": "Saya masih narik sampai lima detik yang lalu.",
"fishline.fish_tilapia_gym_rat.3": "Form joran kamu itu jelek banget.",
"fishline.fish_tilapia_gym_rat.4": "Itu joran pancing.",
"fishline.fish_tilapia_gym_rat.5": "ALASAN!! ITU NOL PROTEIN.",
"fishline.fish_gourami_shady.1": "Kamu tidak melihat apa-apa.",
"fishline.fish_gourami_shady.2": "Saya jelas-jelas narik kamu dari danau.",
"fishline.fish_gourami_shady.3": "Danau ini tidak kenal aku.",
"fishline.fish_gourami_shady.4": "Danau itu tempat saya nemu kamu.",
"fishline.fish_gourami_shady.5": "Konon katanya.",
"fishline.fish_carp_golden.1": "Hati-hati dengan sisik saya. Ini mahal.",
"fishline.fish_carp_golden.2": "Semahal apa?",
"fishline.fish_carp_golden.3": "Lebih mahal dari motor Anda.",
"fishline.fish_carp_golden.4": "Standarnya nggak tinggi-tinggi amat.",
"fishline.fish_carp_golden.5": "Saya benci Anda.",
"fishline.fish_snakehead_sergeant.1": "PEMANCING!",
"fishline.fish_snakehead_sergeant.2": "Kenapa teriak-teriak?",
"fishline.fish_snakehead_sergeant.3": "TARIKANMU KURANG MEYAKINKAN!",
"fishline.fish_snakehead_sergeant.4": "Saya kan sudah nangkep kamu.",
"fishline.fish_snakehead_sergeant.5": "UNTUK SEMENTARA!",
"fishline.fish_arowana_don.1": "Darto.",
"fishline.fish_arowana_don.2": "...Dari mana kamu tahu nama saya?",
"fishline.fish_arowana_don.3": "Danau ini bercerita.",
"fishline.fish_arowana_don.4": "Itu sangat menyeramkan.",
"fishline.fish_arowana_don.5": "Memang seperti itu.",
"fishline.fish_arowana_don_first_win.1": "Nikmati kemenanganmu.",
"fishline.fish_arowana_don_first_win.2": "Memang mau saya nikmati.",
"fishline.fish_arowana_don_first_win.3": "Danau ini akan mengingatnya.",
"fishline.fish_arowana_don_first_win.4": "Nggak masalah.",
"fishline.fish_arowana_don_first_win.5": "Danaunya bayar tiga ratus ribu nggak?",
"fishline.fish_arowana_don_first_win.6": "Kamu menyebalkan.",
"fishline.fish_arowana_don_first_win.7": "Berarti iya.",
"dialogue.baung_satpam.land.1": "Permisi. Izin mancingnya mana?",
"dialogue.baung_satpam.land.2": "Bagian kali ini di bawah pengawasan saya.",
"dialogue.baung_satpam.land.3": "Mohon mundur dari air. Sesuai prosedur.",
"dialogue.baung_satpam.land.4": "Bapak ikut saya. Ke arena.",
"dialogue.baung_satpam.player_win.1": "Dicatat. Saya akan bikin laporan tentang diri saya sendiri.",
"dialogue.baung_satpam.player_win.2": "Silakan lewat. Ke dalam ember.",
"dialogue.baung_satpam.player_win.3": "Waktu jaga saya selesai. Tolong ada yang gantikan saya di jembatan.",
"dialogue.baung_satpam.player_win.4": "Tekniknya bagus. Izinnya tetap nggak ada.",
"dialogue.baung_satpam.fish_win.1": "Area aman terkendali.",
"dialogue.baung_satpam.fish_win.2": "Silakan kembali di jam kunjungan.",
"dialogue.baung_satpam.fish_win.3": "Ini zona bebas ember.",
"dialogue.baung_satpam.fish_win.4": "Terima kasih atas kerja samanya.",
"dialogue.baung_satpam.reel_escape.1": "Tegangan tanpa izin terdeteksi!",
"dialogue.baung_satpam.reel_escape.2": "Senar disita.",
"dialogue.baung_satpam.reel_escape.3": "Evakuasi ke bagian dalam!",
"fish.baung_satpam.subtitle": "SATPAM JEMBATAN",
"fish.baung_satpam.description": "Menjaga jembatan tua dengan peluit yang sebenarnya tidak bisa ia tiup. Menanyakan surat izin ke semua orang. Belum pernah mengeluarkan satu pun.",
"fish.baung_satpam.name": "Baung Satpam",
"fish.baung_satpam.species": "BAUNG",
"fishline.fish_baung_satpam.1": "Berhenti. Siapa di situ?",
"fishline.fish_baung_satpam.2": "Orang yang lagi megang kamu.",
"fishline.fish_baung_satpam.3": "Nama dan keperluan.",
"fishline.fish_baung_satpam.4": "Darto. Mancing. Jelas, kan.",
"fishline.fish_baung_satpam.5": "Keperluan ditolak. Siap-siap.",
"dialogue.tawes_gosip.land.1": "Lho! Kamu kan yang jual rice cooker itu!",
"dialogue.tawes_gosip.land.2": "Tunggu sampai satu kali tahu soal ini.",
"dialogue.tawes_gosip.land.3": "Psst. Aku tahu banyak hal. Lawan aku, nanti kulupakan.",
"dialogue.tawes_gosip.land.4": "Semua orang ngomongin kamu. Terutama aku.",
"dialogue.tawes_gosip.player_win.1": "Ya sudah. Tapi aku bakal bilang ke semua orang kamu curang.",
"dialogue.tawes_gosip.player_win.2": "Ini nggak pernah terjadi. Nanti kuceritakan seolah terjadi.",
"dialogue.tawes_gosip.player_win.3": "Ooh, ember. Gosip di dalam sini mantap.",
"dialogue.tawes_gosip.player_win.4": "Lawan yang bagus. Potongan rambut yang parah.",
"dialogue.tawes_gosip.fish_win.1": "Tunggu sampai Bu Yati dengar.",
"dialogue.tawes_gosip.fish_win.2": "Kalah sama tawes. Berita ini bakal menyebar.",
"dialogue.tawes_gosip.fish_win.3": "Ada sumber yang bilang kamu bakal kalah lagi.",
"dialogue.tawes_gosip.fish_win.4": "Dadaaah. Tenang, nanti kusebarkan gosipnya.",
"dialogue.tawes_gosip.reel_escape.1": "Kabar terkini: senar putus!",
"dialogue.tawes_gosip.reel_escape.2": "Salam buat istrimu, ya.",
"dialogue.tawes_gosip.reel_escape.3": "Ini masuk grup chat.",
"fish.tawes_gosip.subtitle": "PUSAT INFORMASI KAMPUNG",
"fish.tawes_gosip.description": "Tahu siapa utang ke siapa, siapa yang jual rice cooker, dan siapa yang mancing bukannya kerja. Sebagian besar malah benar.",
"fish.tawes_gosip.name": "Tawes Tukang Gosip",
"fish.tawes_gosip.species": "TAWES",
"fishline.fish_tawes_gosip.1": "Ooh, beneran soal rice cooker itu?",
"fishline.fish_tawes_gosip.2": "Kok ikan bisa tahu soal itu?",
"fishline.fish_tawes_gosip.3": "Semua orang tahu. Aku yang mastiin.",
"fishline.fish_tawes_gosip.4": "Mantap. Ikan punya jaringan sosial.",
"fishline.fish_tawes_gosip.5": "Lawan aku, nanti kurahasiakan. Mungkin.",
"dialogue.belut_licin.land.1": "Permisi, numpang lewat.",
"dialogue.belut_licin.land.2": "Maaf, maaf, sebentar lagi saya pergi.",
"dialogue.belut_licin.land.3": "Saya minta maaf duluan soal yang terjadi habis ini.",
"dialogue.belut_licin.land.4": "Mohon maaf. Urusannya bakal licin.",
"dialogue.belut_licin.player_win.1": "Oh. Saya kurang licin. Maaf.",
"dialogue.belut_licin.player_win.2": "Saya mohon maaf sudah tertangkap.",
"dialogue.belut_licin.player_win.3": "Maaf ya, embernya jadi berlendir.",
"dialogue.belut_licin.player_win.4": "Permainan yang bagus. Mohon maaf sekali.",
"dialogue.belut_licin.fish_win.1": "Maaf! Permisi! Dadah!",
"dialogue.belut_licin.fish_win.2": "Saya benar-benar minta maaf soal ini.",
"dialogue.belut_licin.fish_win.3": "Maafkan kaburnya saya.",
"dialogue.belut_licin.fish_win.4": "Jangan dendam. Licin aja.",
"dialogue.belut_licin.reel_escape.1": "Maaf! Kepeleset!",
"dialogue.belut_licin.reel_escape.2": "Permisi, saya pamit.",
"dialogue.belut_licin.reel_escape.3": "Maaf sekali. Licin sekali.",
"fish.belut_licin.subtitle": "AHLI MELOLOSKAN DIRI",
"fish.belut_licin.description": "Terlalu licin untuk dipegang dan terlalu sopan untuk kurang ajar. Minta maaf setiap kali lolos, yang artinya setiap saat.",
"fish.belut_licin.name": "Belut Licin",
"fish.belut_licin.species": "BELUT",
"fishline.fish_belut_licin.1": "Oh! Maaf. Saya ada di tangan Bapak, ya?",
"fishline.fish_belut_licin.2": "Iya. Nyaris.",
"fishline.fish_belut_licin.3": "Maaf sekali. Sebentar lagi saya pergi.",
"fishline.fish_belut_licin.4": "Kamu nggak boleh ke mana-mana.",
"fishline.fish_belut_licin.5": "Kalau begitu, maaf soal duel ini.",
"dialogue.hampala_pembalap.land.1": "BREM BREM! Siapa yang lelet? Kamu yang lelet!",
"dialogue.hampala_pembalap.land.2": "Motormu suaranya kayak orang batuk.",
"dialogue.hampala_pembalap.land.3": "Lampu hijau! Gas gas gas!",
"dialogue.hampala_pembalap.land.4": "Aku nggak kenal rem.",
"dialogue.hampala_pembalap.player_win.1": "Masuk pit. Wajib, katanya.",
"dialogue.hampala_pembalap.player_win.2": "Finis tipis. Aku masuk foto. Di dalam ember.",
"dialogue.hampala_pembalap.player_win.3": "Respek. Refleksmu pakai nitro.",
"dialogue.hampala_pembalap.player_win.4": "Oke. Balapan berikutnya aku bawa sirip yang lebih bagus.",
"dialogue.hampala_pembalap.fish_win.1": "Makan gelembungku!",
"dialogue.hampala_pembalap.fish_win.2": "Rekor putaran. Lagi.",
"dialogue.hampala_pembalap.fish_win.3": "Kelamaan, Om!",
"dialogue.hampala_pembalap.fish_win.4": "Sampai jumpa di garis finis. Aku sudah di sana.",
"dialogue.hampala_pembalap.reel_escape.1": "Oper gigi! Dadah!",
"dialogue.hampala_pembalap.reel_escape.2": "Senarmu nggak kuat ngejar!",
"dialogue.hampala_pembalap.reel_escape.3": "Gas pol!",
"fish.hampala_pembalap.subtitle": "PEMBALAP TANPA SIM",
"fish.hampala_pembalap.description": "Ngebut melawan apa saja yang bergerak, terutama motor di jembatan. Punya pendapat soal motor Darto. Tidak ada yang baik.",
"fish.hampala_pembalap.name": "Hampala Pembalap Liar",
"fish.hampala_pembalap.species": "HAMPALA",
"fishline.fish_hampala_pembalap.1": "Motor yang bagus. Barang museum, ya?",
"fishline.fish_hampala_pembalap.2": "Umurnya dua puluh tahun dan masih jalan.",
"fishline.fish_hampala_pembalap.3": "Nyaris. Aku dengar dari jembatan.",
"fishline.fish_hampala_pembalap.4": "Kamu barusan menghina motor saya?",
"fishline.fish_hampala_pembalap.5": "Balapan sama aku, nanti tahu.",
"dialogue.belida_pendekar.land.1": "Berdiri yang benar. Kakimu sedang membohongimu.",
"dialogue.belida_pendekar.land.2": "Seorang murid datang. Mari kita lihat apa yang ia tahu.",
"dialogue.belida_pendekar.land.3": "Kali mengajariku sabar. Aku akan mengajarimu rendah hati.",
"dialogue.belida_pendekar.land.4": "Beri hormat dulu, Darto. Baru jatuh.",
"dialogue.belida_pendekar.player_win.1": "Bagus. Muridnya ingat pelajaran.",
"dialogue.belida_pendekar.player_win.2": "Aku kalah. Catat. Nanti kubantah.",
"dialogue.belida_pendekar.player_win.3": "Gerakanmu jelek. Tapi berhasil. Itu cukup.",
"dialogue.belida_pendekar.player_win.4": "Pergilah. Ajari ember itu sopan santun.",
"dialogue.belida_pendekar.fish_win.1": "Ulangi. Lebih pelan. Dengan hormat.",
"dialogue.belida_pendekar.fish_win.2": "Kamu menyerang bayanganku. Aku tidak di sana.",
"dialogue.belida_pendekar.fish_win.3": "Kali ini murid yang lebih baik daripada kamu.",
"dialogue.belida_pendekar.fish_win.4": "Kembalilah kalau kuda-kudamu berhenti minta maaf.",
"dialogue.belida_pendekar.reel_escape.1": "Tenaga bukan teknik.",
"dialogue.belida_pendekar.reel_escape.2": "Tarikan kuat, pikiran lemah.",
"dialogue.belida_pendekar.reel_escape.3": "Senarnya putus. Fokusmu putus duluan.",
"fish.belida_pendekar.subtitle": "GURU PERGURUAN KALI KENANGA",
"fish.belida_pendekar.description": "Legenda tua berbentuk pisau yang mengajar silat ke ikan-ikan muda di kali. Belum pernah kalah duel, dan tidak menghitung yang kalah.",
"fish.belida_pendekar.name": "Belida Sang Pendekar",
"fish.belida_pendekar.species": "BELIDA",
"fishline.fish_belida_pendekar.1": "Kamu menarikku dari latihan pagi.",
"fishline.fish_belida_pendekar.2": "Ini jam empat sore.",
"fishline.fish_belida_pendekar.3": "Latihan tidak melihat jam.",
"fishline.fish_belida_pendekar.4": "Kamu... guru silat?",
"fishline.fish_belida_pendekar.5": "Pasang kuda-kuda. Kelas dimulai.",
"dialogue.red_devil_palak.land.1": "Tempat ini ada biayanya. Uang keamanan.",
"dialogue.red_devil_palak.land.2": "Muka baru. Tarif baru.",
"dialogue.red_devil_palak.land.3": "Bayar atau berantem.",
"dialogue.red_devil_palak.land.4": "Nggak ada yang mancing di sini tanpa bayar aku.",
"dialogue.red_devil_palak.player_win.1": "Ya sudah. Kunjungan pertama gratis.",
"dialogue.red_devil_palak.player_win.2": "Kamu bakal bayar ini. Secara harfiah, semoga.",
"dialogue.red_devil_palak.player_win.3": "Bilang ke ember, biayanya dihapus.",
"dialogue.red_devil_palak.player_win.4": "Ini kekalahan jenis invasif.",
"dialogue.red_devil_palak.fish_win.1": "Senang berbisnis denganmu.",
"dialogue.red_devil_palak.fish_win.2": "Biaya diterima. Dalam bentuk harga diri.",
"dialogue.red_devil_palak.fish_win.3": "Balik lagi bawa uang pas.",
"dialogue.red_devil_palak.fish_win.4": "Waduk aku, aturan aku.",
"dialogue.red_devil_palak.reel_escape.1": "Denda telat!",
"dialogue.red_devil_palak.reel_escape.2": "Senarmu nunggak iuran!",
"dialogue.red_devil_palak.reel_escape.3": "Lain kali, bawa uang tunai.",
"fish.red_devil_palak.subtitle": "PEMUNGUT PUNGLI SWADAYA",
"fish.red_devil_palak.description": "Datang tanpa diundang, menghabiskan makan siang semua penghuni, lalu menarik uang keamanan untuk airnya. Belum pernah ada yang bayar. Ia terus menagih.",
"fish.red_devil_palak.name": "Red Devil Tukang Palak",
"fish.red_devil_palak.species": "RED DEVIL",
"fishline.fish_red_devil_palak.1": "Eits, eits. Sepuluh ribu buat tempatnya.",
"fishline.fish_red_devil_palak.2": "Ini waduk umum.",
"fishline.fish_red_devil_palak.3": "Umum, iya. Aman? Itu bayar lagi.",
"fishline.fish_red_devil_palak.4": "Saya sudah punya penagih utang.",
"fishline.fish_red_devil_palak.5": "Berarti kamu sudah paham caranya.",
"dialogue.patin_stempel.land.1": "Silakan ambil nomor antrean.",
"dialogue.patin_stempel.land.2": "Duel ini butuh formulir yang sudah distempel.",
"dialogue.patin_stempel.land.3": "Fotokopi KTP tiga lembar, plus materai.",
"dialogue.patin_stempel.land.4": "Permohonan duel Anda disetujui. Pas-pasan.",
"dialogue.patin_stempel.player_win.1": "Disetujui. Distempel. Dikalahkan.",
"dialogue.patin_stempel.player_win.2": "Berkas Anda dipindahkan ke bagian ember.",
"dialogue.patin_stempel.player_win.3": "Tanda tangan di sini. Dan di sini. Dan di ember.",
"dialogue.patin_stempel.player_win.4": "Proses selesai. Saya tidak suka.",
"dialogue.patin_stempel.fish_win.1": "Permohonan ditolak. Kurang stempel.",
"dialogue.patin_stempel.fish_win.2": "Silakan kembali di hari kerja.",
"dialogue.patin_stempel.fish_win.3": "Sistemnya lagi gangguan. Anda juga.",
"dialogue.patin_stempel.fish_win.4": "Berikutnya!",
"dialogue.patin_stempel.reel_escape.1": "Formulir tidak lengkap!",
"dialogue.patin_stempel.reel_escape.2": "Permohonan Anda diteruskan. Ke jauh.",
"dialogue.patin_stempel.reel_escape.3": "Jam kantor sudah habis.",
"fish.patin_stempel.subtitle": "BAGIAN ADMINISTRASI KOPERASI",
"fish.patin_stempel.description": "Mengurus berkas koperasi waduk dengan dedikasi total. Minta tiga rangkap untuk segala hal. Belum pernah menyelesaikan satu antrean pun.",
"fish.patin_stempel.name": "Patin Juru Stempel",
"fish.patin_stempel.species": "PATIN",
"fishline.fish_patin_stempel.1": "Punya izin mancing dari koperasi?",
"fishline.fish_patin_stempel.2": "Saya nggak tahu ada yang begituan.",
"fishline.fish_patin_stempel.3": "Ada. Prosesnya dua minggu.",
"fishline.fish_patin_stempel.4": "Boleh saya jual ikan ke koperasi aja?",
"fishline.fish_patin_stempel.5": "Khusus anggota. Isi formulir ini. Lalu lawan saya.",
"dialogue.jelawat_influencer.land.1": "Halo guys! Hari ini kita lawan pemancing!",
"dialogue.jelawat_influencer.land.2": "Bentar, bentar, aku cari angle terbaik dulu.",
"dialogue.jelawat_influencer.land.3": "Jangan lupa like dan subscribe!",
"dialogue.jelawat_influencer.land.4": "Ini bakal jadi konten.",
"dialogue.jelawat_influencer.player_win.1": "Cut! Boleh diulang?",
"dialogue.jelawat_influencer.player_win.2": "Kalah malah lebih banyak yang nonton.",
"dialogue.jelawat_influencer.player_win.3": "Embernya estetik banget, sih.",
"dialogue.jelawat_influencer.player_win.4": "Akun pemancing ini ada di deskripsi.",
"dialogue.jelawat_influencer.fish_win.1": "Dan selesai, guys!",
"dialogue.jelawat_influencer.fish_win.2": "Potong! Jadiin klip!",
"dialogue.jelawat_influencer.fish_win.3": "Makasih sudah masuk kontenku!",
"dialogue.jelawat_influencer.fish_win.4": "Pengikut ke-38 segera datang.",
"dialogue.jelawat_influencer.reel_escape.1": "Plot twist!",
"dialogue.jelawat_influencer.reel_escape.2": "Siaran langsung dari dasar waduk!",
"dialogue.jelawat_influencer.reel_escape.3": "Bersambung, guys!",
"fish.jelawat_influencer.subtitle": "KONTEN KREATOR (37 PENGIKUT)",
"fish.jelawat_influencer.description": "Merekam setiap duel untuk tiga puluh tujuh pengikutnya. Sudah dua kali menyuruh Darto mengulang adegan masuk. Pencahayaannya jelek.",
"fish.jelawat_influencer.name": "Jelawat Influencer",
"fish.jelawat_influencer.species": "JELAWAT",
"fishline.fish_jelawat_influencer.1": "Bentar! Udah live? Halo guys!",
"fishline.fish_jelawat_influencer.2": "Kamu ngomong sama siapa?",
"fishline.fish_jelawat_influencer.3": "Pengikutku. Lambaikan tangan.",
"fishline.fish_jelawat_influencer.4": "Saya nggak mau melambai ke waduk.",
"fishline.fish_jelawat_influencer.5": "Nggak sopan. Ini masuk thumbnail.",
"dialogue.betutu_mager.land.1": "Aduh. Harus banget?",
"dialogue.betutu_mager.land.2": "Lima menit lagi.",
"dialogue.betutu_mager.land.3": "Aku lawan kamu sambil rebahan. Itu gayaku.",
"dialogue.betutu_mager.land.4": "Bangunkan aku kalau sudah selesai.",
"dialogue.betutu_mager.player_win.1": "Ya sudah. Embernya kelihatan nyaman juga.",
"dialogue.betutu_mager.player_win.2": "Terlalu capek untuk kesal.",
"dialogue.betutu_mager.player_win.3": "Gendong aku. Pelan-pelan.",
"dialogue.betutu_mager.player_win.4": "Nggak apa-apa. Semuanya nggak apa-apa. Zzz.",
"dialogue.betutu_mager.fish_win.1": "Tadi itu butuh tenaga. Aku mau tidur lagi.",
"dialogue.betutu_mager.fish_win.2": "Zzz... hah? Aku menang?",
"dialogue.betutu_mager.fish_win.3": "Malas pun bisa kalahkan capek.",
"dialogue.betutu_mager.fish_win.4": "Jangan bangunkan aku buat tanding ulang.",
"dialogue.betutu_mager.reel_escape.1": "Nggak. Terlalu repot.",
"dialogue.betutu_mager.reel_escape.2": "Aku keluar. Secara harfiah.",
"dialogue.betutu_mager.reel_escape.3": "Jam tidur. Dadah.",
"fish.betutu_mager.subtitle": "PEREBAHAN PROFESIONAL",
"fish.betutu_mager.description": "Mahal, langka, dan sama sekali tidak tertarik bergerak. Menyambar kail cuma karena posisinya lebih dekat daripada camilan yang ia mau.",
"fish.betutu_mager.name": "Betutu Mager",
"fish.betutu_mager.species": "BETUTU",
"fishline.fish_betutu_mager.1": "Mmh. Taruh lagi. Aku lagi istirahat.",
"fishline.fish_betutu_mager.2": "Kamu yang makan kail saya.",
"fishline.fish_betutu_mager.3": "Itu benda yang paling dekat dari mulutku.",
"fishline.fish_betutu_mager.4": "Harganya mahal tapi melek aja susah.",
"fishline.fish_betutu_mager.5": "Dua-duanya bisa benar. Ayo duel. Pelan-pelan.",
"dialogue.toman_jenderal.land.1": "Istirahat di tempat. Tidak akan lama.",
"dialogue.toman_jenderal.land.2": "Sersanku bercerita tentangmu. Tidak baik.",
"dialogue.toman_jenderal.land.3": "Kamu memasuki wilayah komandoku. Lapor.",
"dialogue.toman_jenderal.land.4": "Strategi, Darto. Bukan tenaga.",
"dialogue.toman_jenderal.player_win.1": "Eksekusi yang baik. Bubar jalan.",
"dialogue.toman_jenderal.player_win.2": "Silakan beri tahu sersan. Dia akan lari keliling.",
"dialogue.toman_jenderal.player_win.3": "Mundur taktis ke ember. Dicatat.",
"dialogue.toman_jenderal.player_win.4": "Kamu bertarung dengan disiplin. Aku setuju.",
"dialogue.toman_jenderal.fish_win.1": "Misi selesai.",
"dialogue.toman_jenderal.fish_win.2": "Kembalilah kalau sudah punya rencana.",
"dialogue.toman_jenderal.fish_win.3": "Perairan dalam bertahan.",
"dialogue.toman_jenderal.fish_win.4": "Keberanianmu dicatat. Teknikmu tidak.",
"dialogue.toman_jenderal.reel_escape.1": "Lepas kontak.",
"dialogue.toman_jenderal.reel_escape.2": "Senarmu keluar barisan.",
"dialogue.toman_jenderal.reel_escape.3": "Penarikan selesai.",
"fish.toman_jenderal.subtitle": "PANGLIMA PERAIRAN DALAM",
"fish.toman_jenderal.description": "Gabus raksasa yang melatih Sersan Gabus dan tidak menyesal sedikit pun. Mengatur waduk seperti asrama tentara. Belum pernah meninggikan suara. Tidak pernah perlu.",
"fish.toman_jenderal.name": "Jenderal Toman",
"fish.toman_jenderal.species": "TOMAN",
"fishline.fish_toman_jenderal.1": "Jadi. Kamu yang mengalahkan sersanku.",
"fishline.fish_toman_jenderal.2": "Dia banyak teriak.",
"fishline.fish_toman_jenderal.3": "Dia dilatih untuk itu. Aku tidak.",
"fishline.fish_toman_jenderal.4": "Kok malah lebih seram.",
"fishline.fish_toman_jenderal.5": "Bagus. Takut adalah pelajaran pertama.",
"dialogue.bandeng_tanpa_duri.land.1": "Kabar baik: aku nggak ada durinya!",
"dialogue.bandeng_tanpa_duri.land.2": "Percaya deh. Aku yang paling jujur.",
"dialogue.bandeng_tanpa_duri.land.3": "Aku nggak pernah kalah. Ini duel pertamaku.",
"dialogue.bandeng_tanpa_duri.land.4": "Sebenarnya aku hiu.",
"dialogue.bandeng_tanpa_duri.player_win.1": "Aku sengaja ngalah. Itu benar. Mungkin.",
"dialogue.bandeng_tanpa_duri.player_win.2": "Bilang ke Bu Yati aku nggak ada durinya. Dia bakal percaya.",
"dialogue.bandeng_tanpa_duri.player_win.3": "Aku bahkan nggak di ember. Jangan dilihat.",
"dialogue.bandeng_tanpa_duri.player_win.4": "Aduh. Itu satu-satunya duriku.",
"dialogue.bandeng_tanpa_duri.fish_win.1": "Aku selalu menang. Yang ini benar.",
"dialogue.bandeng_tanpa_duri.fish_win.2": "Aku nggak pernah di sini.",
"dialogue.bandeng_tanpa_duri.fish_win.3": "Dadah! Sekarang aku lumba-lumba.",
"dialogue.bandeng_tanpa_duri.fish_win.4": "Kamu kalah sama ikan tanpa duri. Pikirkan itu.",
"dialogue.bandeng_tanpa_duri.reel_escape.1": "Aku tanpa duri! Langsung lolos!",
"dialogue.bandeng_tanpa_duri.reel_escape.2": "Itu bukan aku. Itu bandeng lain.",
"dialogue.bandeng_tanpa_duri.reel_escape.3": "Bohong deh, aku masih di kail. Dadah!",
"fish.bandeng_tanpa_duri.subtitle": "BERSERTIFIKAT TANPA DURI (BUATAN SENDIRI)",
"fish.bandeng_tanpa_duri.description": "Mengaku tanpa duri, jadi katanya paling gampang dijual. Durinya paling banyak se-muara. Bohong soal hal lain juga.",
"fish.bandeng_tanpa_duri.name": "Bandeng Tanpa Duri",
"fish.bandeng_tanpa_duri.species": "BANDENG",
"fishline.fish_bandeng_tanpa_duri.1": "Sebelum kamu tanya: nggak ada duri. Satu pun nggak.",
"fishline.fish_bandeng_tanpa_duri.2": "Dari sini saya bisa lihat durinya.",
"fishline.fish_bandeng_tanpa_duri.3": "Itu hiasan.",
"fishline.fish_bandeng_tanpa_duri.4": "Bu Yati bakal nyabutin satu-satu dari giginya.",
"fishline.fish_bandeng_tanpa_duri.5": "Kalau gitu dia harus menang dulu. Kamu juga.",
"dialogue.buntal_pemarah.land.1": "Jangan. Sentuh. Duriku.",
"dialogue.buntal_pemarah.land.2": "Kamu bikin aku kembung. Berhenti.",
"dialogue.buntal_pemarah.land.3": "Aku BUKAN bulat. Ini otot.",
"dialogue.buntal_pemarah.land.4": "Satu kata lagi, ukuranku jadi dua kali lipat.",
"dialogue.buntal_pemarah.player_win.1": "Hmph. Aku mengempis karena dendam.",
"dialogue.buntal_pemarah.player_win.2": "Ya sudah. Tapi embernya terlalu kecil untuk amarahku.",
"dialogue.buntal_pemarah.player_win.3": "Ugh. Sekarang aku bulat DAN kalah.",
"dialogue.buntal_pemarah.player_win.4": "Jangan lihat aku. Aku masih kembung.",
"dialogue.buntal_pemarah.fish_win.1": "HA! Takutlah pada bola!",
"dialogue.buntal_pemarah.fish_win.2": "Itu yang terjadi kalau aku kesal.",
"dialogue.buntal_pemarah.fish_win.3": "Aku masih marah. Pergi sana.",
"dialogue.buntal_pemarah.fish_win.4": "Bagus. Sekarang aku bisa mengempis dengan tenang.",
"dialogue.buntal_pemarah.reel_escape.1": "TERLALU BULAT UNTUK DIPEGANG!",
"dialogue.buntal_pemarah.reel_escape.2": "Aku menggelinding pergi sebagai protes!",
"dialogue.buntal_pemarah.reel_escape.3": "Jangan ikuti aku. Aku berduri.",
"fish.buntal_pemarah.subtitle": "SUMBU PENDEK, BADAN BULAT",
"fish.buntal_pemarah.description": "Cepat marah dan lebih cepat lagi membulat. Bersikeras bahwa ia tidak menggembung. Ia sedang menggembung.",
"fish.buntal_pemarah.name": "Buntal Pemarah",
"fish.buntal_pemarah.species": "BUNTAL",
"fishline.fish_buntal_pemarah.1": "Lihat apa kamu?",
"fishline.fish_buntal_pemarah.2": "Badanmu makin besar.",
"fishline.fish_buntal_pemarah.3": "NGGAK. Ini ukuran normalku.",
"fishline.fish_buntal_pemarah.4": "Kamu segede bola.",
"fishline.fish_buntal_pemarah.5": "Cukup. Sekarang aku marah.",
"dialogue.glodok_pelari.land.1": "Kamu menangkapku pas putaran pemanasan.",
"dialogue.glodok_pelari.land.2": "Aku bisa jalan di darat. Kamu bisa berenang? Kayaknya nggak.",
"dialogue.glodok_pelari.land.3": "Bersedia.",
"dialogue.glodok_pelari.land.4": "Rekor pribadiku di bawah tiga detik. Tanya rekor apa.",
"dialogue.glodok_pelari.player_win.1": "Rekor terburuk baru. Dicatat.",
"dialogue.glodok_pelari.player_win.2": "Aku jalan sendiri ke ember, makasih.",
"dialogue.glodok_pelari.player_win.3": "Kecepatanmu bagus. Kamu cocok di lumpur.",
"dialogue.glodok_pelari.player_win.4": "Aku lagi pendinginan. Itu alasanku.",
"dialogue.glodok_pelari.fish_win.1": "Rekor pribadi!",
"dialogue.glodok_pelari.fish_win.2": "Sampai jumpa di garis finis. Aku sudah lama di sini.",
"dialogue.glodok_pelari.fish_win.3": "Air surut, kecepatan naik.",
"dialogue.glodok_pelari.fish_win.4": "Larimu kayak orang dikejar utang.",
"dialogue.glodok_pelari.reel_escape.1": "Lari!",
"dialogue.glodok_pelari.reel_escape.2": "Aku cabut! Jalan kaki!",
"dialogue.glodok_pelari.reel_escape.3": "Curi start! Punyaku!",
"fish.glodok_pelari.subtitle": "IKAN TERCEPAT DI LUMPUR",
"fish.glodok_pelari.description": "Berlari di lumpur lebih cepat dari makhluk bersirip mana pun. Latihan setiap air surut. Punya rekor pribadi dan selalu menyebutnya.",
"fish.glodok_pelari.name": "Glodok Pelari",
"fish.glodok_pelari.species": "GLODOK",
"fishline.fish_glodok_pelari.1": "Hati-hati. Kaki ini sudah diasuransikan.",
"fishline.fish_glodok_pelari.2": "Ikan nggak punya kaki.",
"fishline.fish_glodok_pelari.3": "Sirip. Sirip lari. Sama aja.",
"fishline.fish_glodok_pelari.4": "Kamu ikan yang lari di lumpur.",
"fishline.fish_glodok_pelari.5": "Dan kamu orang yang kalah lomba. Bersedia.",
"dialogue.kakap_sosialita.land.1": "Sayang, kamu datang pakai baju itu?",
"dialogue.kakap_sosialita.land.2": "Aku ada arisan. Cepat sedikit.",
"dialogue.kakap_sosialita.land.3": "Kamu tahu aku siapa? Nggak? Kasihan.",
"dialogue.kakap_sosialita.land.4": "Berantem itu tren musim lalu. Ya sudah.",
"dialogue.kakap_sosialita.player_win.1": "Sayang, ember itu bukan estetikaku.",
"dialogue.kakap_sosialita.player_win.2": "Bilang ke semua orang aku kalah dengan anggun.",
"dialogue.kakap_sosialita.player_win.3": "Ugh. Habis ini aku butuh spa.",
"dialogue.kakap_sosialita.player_win.4": "Oke. Tapi pengacaraku akan dengar soal ini.",
"dialogue.kakap_sosialita.fish_win.1": "Muah! Jangan telepon aku.",
"dialogue.kakap_sosialita.fish_win.2": "Lucu. Kamu sudah berusaha.",
"dialogue.kakap_sosialita.fish_win.3": "Aku telat brunch. Dah, sayang.",
"dialogue.kakap_sosialita.fish_win.4": "Kekalahan cocok buatmu, sayang.",
"dialogue.kakap_sosialita.reel_escape.1": "Ciao!",
"dialogue.kakap_sosialita.reel_escape.2": "Senarmu murahan sekali, sayang.",
"dialogue.kakap_sosialita.reel_escape.3": "Aku punya tempat yang lebih baik.",
"fish.kakap_sosialita.subtitle": "SOSIALITA MUARA",
"fish.kakap_sosialita.description": "Hadir di setiap arisan di muara dan menilai pakaian semua orang. Memanggil semua orang sayang, dan itu tidak pernah pujian.",
"fish.kakap_sosialita.name": "Kakap Sosialita",
"fish.kakap_sosialita.species": "KAKAP PUTIH",
"fishline.fish_kakap_sosialita.1": "Permisi. Kamu tahu harga aku berapa?",
"fishline.fish_kakap_sosialita.2": "Lebih mahal dari motor saya, kayaknya.",
"fishline.fish_kakap_sosialita.3": "Sayang, semuanya lebih mahal dari motormu.",
"fishline.fish_kakap_sosialita.4": "Ikan mas emas juga bilang begitu.",
"fishline.fish_kakap_sosialita.5": "Berarti dia punya selera. Ayo cepat selesaikan.",
"dialogue.sembilang_tua.land.1": "Zaman dulu, pemancing minta izin dulu.",
"dialogue.sembilang_tua.land.2": "Aku sudah lihat pasang yang lebih tua dari kamu.",
"dialogue.sembilang_tua.land.3": "Hati-hati. Patilku lebih tua dari alasan-alasanmu.",
"dialogue.sembilang_tua.land.4": "Pohon bakau ingat aku waktu muda. Samar-samar.",
"dialogue.sembilang_tua.player_win.1": "Hmph. Kamu mengingatkanku pada pria yang dulu mancing di sini.",
"dialogue.sembilang_tua.player_win.2": "Duel yang bagus, anak muda.",
"dialogue.sembilang_tua.player_win.3": "Bawa aku. Pinggangku juga sudah pegal.",
"dialogue.sembilang_tua.player_win.4": "Muara bakal membicarakan ini puluhan tahun.",
"dialogue.sembilang_tua.fish_win.1": "Anak zaman sekarang.",
"dialogue.sembilang_tua.fish_win.2": "Kembalilah kalau sudah paham pasang surut.",
"dialogue.sembilang_tua.fish_win.3": "Akar bertahan. Aku juga.",
"dialogue.sembilang_tua.fish_win.4": "Aku sudah kalah duel sebelum kamu lahir. Bukan hari ini.",
"dialogue.sembilang_tua.reel_escape.1": "Pasang membawaku pulang.",
"dialogue.sembilang_tua.reel_escape.2": "Terlalu buru-buru. Seperti semuanya.",
"dialogue.sembilang_tua.reel_escape.3": "Sabar itu cara lama.",
"fish.sembilang_tua.subtitle": "PENUNGGU AKAR BAKAU",
"fish.sembilang_tua.description": "Makhluk tertua di muara, termasuk pohon bakaunya. Sudah mengeluhkan ikan-ikan muda, air pasang, dan harga segala sesuatu sejak sebelum Darto lahir.",
"fish.sembilang_tua.name": "Sembilang Tua",
"fish.sembilang_tua.species": "SEMBILANG",
"fishline.fish_sembilang_tua.1": "Hm. Matamu mirip dia.",
"fishline.fish_sembilang_tua.2": "Mata siapa?",
"fishline.fish_sembilang_tua.3": "Pria yang dulu mencari kepiting di sini. Dulu sekali. Orang baik.",
"fishline.fish_sembilang_tua.4": "Bapak mertua saya dulu mancing di sini.",
"fishline.fish_sembilang_tua.5": "Kalau begitu bertarunglah dengan baik. Demi dia.",
"dialogue.tongkol_ojol.land.1": "Ada orderan sepuluh menit lagi. Ayo cepat.",
"dialogue.tongkol_ojol.land.2": "OTW! Maksudku, sudah di sini!",
"dialogue.tongkol_ojol.land.3": "Bintang lima kalau kamu cepat kalah.",
"dialogue.tongkol_ojol.land.4": "Aku lagi dikejar waktu, Om.",
"dialogue.tongkol_ojol.player_win.1": "Orderan dibatalkan.",
"dialogue.tongkol_ojol.player_win.2": "Mohon beri penilaian untuk kinerja saya.",
"dialogue.tongkol_ojol.player_win.3": "Ya sudah. Ember jadi titik antar terakhir.",
"dialogue.tongkol_ojol.player_win.4": "Rating hancur. Makasih, Om.",
"dialogue.tongkol_ojol.fish_win.1": "Pesanan sampai!",
"dialogue.tongkol_ojol.fish_win.2": "Bintang lima buat aku!",
"dialogue.tongkol_ojol.fish_win.3": "Harus jalan, ada orderan lagi!",
"dialogue.tongkol_ojol.fish_win.4": "Tip opsional. Kalah nggak.",
"dialogue.tongkol_ojol.reel_escape.1": "Telat nih!",
"dialogue.tongkol_ojol.reel_escape.2": "Lewat jalan tikus di laut dalam!",
"dialogue.tongkol_ojol.reel_escape.3": "Orderan berikutnya nunggu!",
"fish.tongkol_ojol.subtitle": "SELALU OTW",
"fish.tongkol_ojol.description": "Selalu mengantar sesuatu ke suatu tempat dengan buru-buru. Ratingnya bintang lima dan jadwalnya padat sekali. Mau duel di sela-sela orderan.",
"fish.tongkol_ojol.name": "Tongkol Ojol",
"fish.tongkol_ojol.species": "TONGKOL",
"fishline.fish_tongkol_ojol.1": "Maaf, Bapak pemesan saya?",
"fishline.fish_tongkol_ojol.2": "Bukan. Saya pemancing.",
"fishline.fish_tongkol_ojol.3": "Kalau gitu lepasin, saya ada orderan.",
"fishline.fish_tongkol_ojol.4": "Memangnya tongkol bisa ngantar apa?",
"fishline.fish_tongkol_ojol.5": "Kekalahan. Kilat. Ayo.",
"dialogue.layur_penyair.land.1": "Wahai pemancing, kau telah mengail seorang penyair.",
"dialogue.layur_penyair.land.2": "Bulan menangis. Kau pun akan begitu.",
"dialogue.layur_penyair.land.3": "Pandanglah perakku. Lalu putus asalah.",
"dialogue.layur_penyair.land.4": "Setiap duel adalah puisi. Yang ini tragedi.",
"dialogue.layur_penyair.player_win.1": "Akhir yang sedih. Jenis favoritku.",
"dialogue.layur_penyair.player_win.2": "Ember. Betapa sederhana nan tragis.",
"dialogue.layur_penyair.player_win.3": "Catat ini. Buat berirama.",
"dialogue.layur_penyair.player_win.4": "Aku jatuh, laksana pasang senja.",
"dialogue.layur_penyair.fish_win.1": "Dan demikianlah, sang penyair berenang pergi.",
"dialogue.layur_penyair.fish_win.2": "Kekalahanmu adalah baitku.",
"dialogue.layur_penyair.fish_win.3": "Laut bertepuk tangan. Pelan-pelan.",
"dialogue.layur_penyair.fish_win.4": "Tamat.",
"dialogue.layur_penyair.reel_escape.1": "Senar ini, seperti cinta, telah putus.",
"dialogue.layur_penyair.reel_escape.2": "Aku kembali ke air yang gelap.",
"dialogue.layur_penyair.reel_escape.3": "Selamat tinggal, pemancing tanpa rima.",
"fish.layur_penyair.subtitle": "PENYAIR AIR PASANG MALAM",
"fish.layur_penyair.description": "Panjang, keperakan, dan dramatis soal apa saja. Membacakan puisi tentang bulan, laut, dan bayangannya sendiri. Kebanyakan bayangannya sendiri.",
"fish.layur_penyair.name": "Layur Penyair",
"fish.layur_penyair.species": "LAYUR",
"fishline.fish_layur_penyair.1": "Siapa yang mengusik penyair di tengah bait?",
"fishline.fish_layur_penyair.2": "Orang yang punya utang dan joran.",
"fishline.fish_layur_penyair.3": "Betapa tragis. Betapa indah.",
"fishline.fish_layur_penyair.4": "Kebanyakan cuma tragis.",
"fishline.fish_layur_penyair.5": "Mari kita bertarung, dan menjadikannya seni.",
"dialogue.barakuda_rentenir.land.1": "Butuh uang cepat? Bisa kubantu. Tanda tangan di sini.",
"dialogue.barakuda_rentenir.land.2": "Bunga rendah. Moral lebih rendah.",
"dialogue.barakuda_rentenir.land.3": "Utangmu lambat. Bisa kubikin cepat.",
"dialogue.barakuda_rentenir.land.4": "Semua orang akhirnya bayar ke aku.",
"dialogue.barakuda_rentenir.player_win.1": "Kamu bakal balik. Semua selalu balik.",
"dialogue.barakuda_rentenir.player_win.2": "Ya sudah. Ember nggak pakai bunga.",
"dialogue.barakuda_rentenir.player_win.3": "Jalan pintas itu bagian yang gampang, ya?",
"dialogue.barakuda_rentenir.player_win.4": "Respek. Kamu baca tulisan kecilnya.",
"dialogue.barakuda_rentenir.fish_win.1": "Bunga bertambah.",
"dialogue.barakuda_rentenir.fish_win.2": "Bayar pakai harga diri.",
"dialogue.barakuda_rentenir.fish_win.3": "Tawaranku masih berlaku. Selamanya.",
"dialogue.barakuda_rentenir.fish_win.4": "Uang kilat, pemancing lambat.",
"dialogue.barakuda_rentenir.reel_escape.1": "Telat bayar!",
"dialogue.barakuda_rentenir.reel_escape.2": "Senarmu gagal bayar!",
"dialogue.barakuda_rentenir.reel_escape.3": "Nanti kutagih.",
"fish.barakuda_rentenir.subtitle": "PINJAMAN KILAT, GIGI LEBIH KILAT",
"fish.barakuda_rentenir.description": "Menawarkan pinjaman instan kepada siapa saja yang terlihat lelah. Menyebut bunganya fleksibel. Darto selalu menolak, setiap kali.",
"fish.barakuda_rentenir.name": "Barakuda Rentenir",
"fish.barakuda_rentenir.species": "BARAKUDA",
"fishline.fish_barakuda_rentenir.1": "Kamu kelihatan capek. Perlu pinjaman kecil?",
"fishline.fish_barakuda_rentenir.2": "Nggak.",
"fishline.fish_barakuda_rentenir.3": "Langsung cair. Tanpa banyak tanya.",
"fishline.fish_barakuda_rentenir.4": "Nggak ada jalan pintas. Saya sudah selesai sama yang begitu.",
"fishline.fish_barakuda_rentenir.5": "Kalau begitu kita pakai cara yang susah.",
"dialogue.kerapu_juragan.land.1": "Kamu tahu siapa pemilik dermaga ini? Aku. Sebagian.",
"dialogue.kerapu_juragan.land.2": "Kubayar kamu buat lempar aku balik. Nggak? Ya sudah.",
"dialogue.kerapu_juragan.land.3": "Bisnis dulu. Baru kekerasan.",
"dialogue.kerapu_juragan.land.4": "Kapal-kapalku menonton.",
"dialogue.kerapu_juragan.player_win.1": "Kesepakatan bagus. Buat kamu.",
"dialogue.kerapu_juragan.player_win.2": "Bilang ke Bu Yati aku minta harga pantas.",
"dialogue.kerapu_juragan.player_win.3": "Ya sudah. Embernya nanti kubeli.",
"dialogue.kerapu_juragan.player_win.4": "Kamu jago nawar, pemancing.",
"dialogue.kerapu_juragan.fish_win.1": "Transaksi selesai.",
"dialogue.kerapu_juragan.fish_win.2": "Nggak ada yang bisa ngalahin juragan di dermaganya sendiri.",
"dialogue.kerapu_juragan.fish_win.3": "Kerja buat aku aja. Gaji awal: nggak ada.",
"dialogue.kerapu_juragan.fish_win.4": "Anak buahku bakal dengar soal ini. Keras-keras.",
"dialogue.kerapu_juragan.reel_escape.1": "Aku membeli kebebasanku!",
"dialogue.kerapu_juragan.reel_escape.2": "Kembali ke kapal!",
"dialogue.kerapu_juragan.reel_escape.3": "Senarmu kemurahan.",
"fish.kerapu_juragan.subtitle": "PUNYA TIGA KAPAL (KATANYA)",
"fish.kerapu_juragan.description": "Punya tiga kapal, satu gudang, dan suara yang sangat keras. Membuat juru lelang TPI pingsan karena menawar harganya sendiri. Dapat harga bagus.",
"fish.kerapu_juragan.name": "Kerapu Juragan",
"fish.kerapu_juragan.species": "KERAPU",
"fishline.fish_kerapu_juragan.1": "Hati-hati dengan barang dagangan.",
"fishline.fish_kerapu_juragan.2": "Kamu barang dagangannya.",
"fishline.fish_kerapu_juragan.3": "Tepat. Dan aku mahal.",
"fishline.fish_kerapu_juragan.4": "Bu Yati yang menentukan itu.",
"fishline.fish_kerapu_juragan.5": "Kalau gitu ayo bernegosiasi. Pakai tinju.",
"dialogue.layaran_kapten.land.1": "Laut bercerita tentangmu, Darto.",
"dialogue.layaran_kapten.land.2": "Kamu sudah jauh dari danau kecil itu.",
"dialogue.layaran_kapten.land.3": "Kembangkan layarmu. Anginnya bagus.",
"dialogue.layaran_kapten.land.4": "Hanya yang sabar yang sampai ke laut lepas.",
"dialogue.layaran_kapten.player_win.1": "Pelayaran yang bagus, pemancing.",
"dialogue.layaran_kapten.player_win.2": "Laut akan mengingat pasang ini.",
"dialogue.layaran_kapten.player_win.3": "Pulanglah. Keluargamu menunggu.",
"dialogue.layaran_kapten.player_win.4": "Kamu tidak mengambil jalan pintas. Bagus.",
"dialogue.layaran_kapten.fish_win.1": "Laut itu luas. Coba lagi.",
"dialogue.layaran_kapten.fish_win.2": "Belum, Darto. Tapi sebentar lagi.",
"dialogue.layaran_kapten.fish_win.3": "Kapten yang baik tahu kapan harus putar balik.",
"dialogue.layaran_kapten.fish_win.4": "Pasang akan membawamu kembali.",
"dialogue.layaran_kapten.reel_escape.1": "Laut lepas memanggil.",
"dialogue.layaran_kapten.reel_escape.2": "Tahan senarnya, bukan amarahnya.",
"dialogue.layaran_kapten.reel_escape.3": "Selamat tinggal, untuk sekarang.",
"fish.layaran_kapten.subtitle": "LEGENDA LAUT LEPAS",
"fish.layaran_kapten.description": "Makhluk tercepat di laut dan cerita tertua di dermaga. Kata para pelaut, siapa pun yang mengalahkannya tak akan butuh jalan pintas lagi. Para pelaut memang banyak omong.",
"fish.layaran_kapten.name": "Kapten Layaran",
"fish.layaran_kapten.species": "IKAN LAYARAN",
"fishline.fish_layaran_kapten.1": "Jadi. Pemancing dari danau itu.",
"fishline.fish_layaran_kapten.2": "Sekarang semua ikan kenal saya?",
"fishline.fish_layaran_kapten.3": "Air saling bercerita. Danau, kali, laut.",
"fishline.fish_layaran_kapten.4": "Berarti kamu tahu saya hampir selesai.",
"fishline.fish_layaran_kapten.5": "Kalau begitu tunjukkan bagaimana kamu menyelesaikan sesuatu.",
"location.cempaka.name": "Danau Cempaka",
"location.cempaka.trait": "Air tenang. Tempat semuanya dimulai.",
"location.kenanga.name": "Kali Kenanga",
"location.kenanga.trait": "Arus deras: penanda gulung terus turun.",
"location.kenanga.gear": "Kail Arus",
"location.kenanga.gear_desc": "Kail berat yang tetap tertanam di air deras. Membuka Kali Kenanga.",
"location.melati.name": "Waduk Melati",
"location.melati.trait": "Air dalam: tunggu lebih lama, ikan lebih besar.",
"location.melati.gear": "Senar Panjang",
"location.melati.gear_desc": "Menjangkau air dalam. Membuka Waduk Melati.",
"location.anggrek.name": "Muara Anggrek",
"location.anggrek.trait": "Pasang surut: pasang bawa ikan, surut bawa sampah.",
"location.anggrek.gear": "Sepatu Bot",
"location.anggrek.gear_desc": "Menjaga kamu tetap berdiri di lumpur muara. Membuka Muara Anggrek.",
"location.mawar.name": "Dermaga Mawar",
"location.mawar.trait": "Ombak: senar menegang setiap ombak datang.",
"location.mawar.gear": "Joran Laut",
"location.mawar.gear_desc": "Cukup kuat untuk ikan laut dan air garam. Membuka Dermaga Mawar.",
"arrival.kenanga.1": "Kali Kenanga. Arusnya deras hari ini.",
"arrival.kenanga.2": "Pembeli di jembatan itu. Timbangannya miring, senyumnya lebar.",
"arrival.kenanga.3": "Nggak, makasih. Semua saya jual ke Bu Yati.",
"arrival.melati.1": "Waduk Melati. Sekolah Nisa ada di sebelah sana.",
"arrival.melati.2": "Kantor koperasi ada antrean. Tapi sekarang kan hari Minggu.",
"arrival.melati.3": "Mancing aja. Formulirnya bisa nunggu selamanya.",
"arrival.anggrek.1": "Muara Anggrek. Baunya garam dan lumpur.",
"arrival.anggrek.2": "Bapak mertua dulu menyusuri lumpur ini bawa keranjang kepiting.",
"arrival.anggrek.3": "Pasang, surut. Harus saya perhatikan.",
"arrival.mawar.1": "Dermaga Mawar. Itu laut. Semuanya.",
"arrival.mawar.2": "Pelelangan di sebelah sana. Juru lelangnya masih kelihatan pucat.",
"arrival.mawar.3": "Ikan dari mana pun, tetap akhirnya ke Bu Yati.",
"story.story_unlock_kenanga.01": "Bapak mobil boks putih telepon lagi.",
"story.story_unlock_kenanga.02": "Mau lele lagi?",
"story.story_unlock_kenanga.03": "Baung. Ikan kali. Danaumu nggak ada.",
"story.story_unlock_kenanga.04": "Ada kali di sebelah sana, ngelewatin jembatan tua.",
"story.story_unlock_kenanga.05": "Kali Kenanga. Arusnya kuat. Harus pakai kail arus. Beli saja.",
"story.story_unlock_kenanga.06": "Pasti beli dari Ibu.",
"story.story_unlock_kenanga.07": "Tentu saja dari saya. Dan ikannya kamu jual ke saya.",
"story.story_unlock_kenanga.08": "Tapi kan di jembatan ada pembeli juga.",
"story.story_unlock_kenanga.09": "Yang timbangannya miring itu? Silakan. Rugi nanti.",
"story.story_unlock_kenanga.10": "...Yaudah iya, saya jual ke Ibu.",
"story.story_unlock_kenanga.11": "Bagus. Ikan dari mana pun, ujungnya tetap ke sini.",
"story.story_unlock_kenanga.12": "TEMPAT BARU: KALI KENANGA",
"story.story_unlock_kenanga.13": "Beli Kail Arus di warung, lalu ketuk peta di tepi air.",
"story.story_unlock_melati.01": "Yah, dekat asramaku ada waduk.",
"story.story_unlock_melati.02": "Oh ya?",
"story.story_unlock_melati.03": "Kata anak-anak ada ikan red devil di sana. Galak.",
"story.story_unlock_melati.04": "Ayah sudah ketemu ikan galak. Ayah udah profesional sekarang.",
"story.story_unlock_melati.05": "Kalau ke sana, lambaikan tangan ke sekolahku.",
"story.story_unlock_melati.06": "Waduk Melati? Kamu butuh senar panjang. Airnya dalam.",
"story.story_unlock_melati.07": "Di sana kan ada koperasi nelayan.",
"story.story_unlock_melati.08": "Khusus anggota. Butuh fotokopi KTP dan KK tiga lembar terus nunggu dua minggu.",
"story.story_unlock_melati.09": "Kalau Ibu?",
"story.story_unlock_melati.10": "Saya cuma tanya satu hal.",
"story.story_unlock_melati.11": "Ikannya seger?",
"story.story_unlock_melati.12": "Nah. Kamu sudah hafal prosedurnya.",
"story.story_unlock_melati.13": "TEMPAT BARU: WADUK MELATI",
"story.story_unlock_melati.14": "Beli Senar Panjang di warung. Airnya dalam dan ikannya berat.",
"story.story_unlock_anggrek.01": "Kata Bu Yati kamu mau ke muara.",
"story.story_unlock_anggrek.02": "Cepat juga beritanya nyebar.",
"story.story_unlock_anggrek.03": "Bapak dulu suka cari kepiting di sana.",
"story.story_unlock_anggrek.04": "Iyakah? Aku baru tahu.",
"story.story_unlock_anggrek.05": "Selalu dibawa terus dijual ke warung yang sama.",
"story.story_unlock_anggrek.06": "Warung Bu Yati?",
"story.story_unlock_anggrek.07": "Waktu itu masih punya ibunya. Pakai sepatu bot. Becek.",
"story.story_unlock_anggrek.08": "Bapak mertuamu jual kepiting ke kami selama dua puluh tahun.",
"story.story_unlock_anggrek.09": "Dua puluh tahun di warung yang sama?",
"story.story_unlock_anggrek.10": "Timbangan kami nggak pernah curang. Dia nggak pernah jual ke tempat lain.",
"story.story_unlock_anggrek.11": "Pantas semuanya ujungnya ke sini.",
"story.story_unlock_anggrek.12": "Sepatu botnya di rak.",
"story.story_unlock_anggrek.13": "TEMPAT BARU: MUARA ANGGREK",
"story.story_unlock_anggrek.14": "Beli Sepatu Bot di warung. Perhatikan air: pasang bawa ikan.",
"story.story_unlock_mawar.01": "Mengenai pasokan rutin. Bapak mobil boks setuju.",
"story.story_unlock_mawar.02": "Jadi saya punya pekerjaan dong.",
"story.story_unlock_mawar.03": "Kamu punya kontrak. Bulan depan ada hajatan. Dia mau ikan laut.",
"story.story_unlock_mawar.04": "Dermaga Mawar? Jauh banget itu.",
"story.story_unlock_mawar.05": "Motormu harusnya masih bisa sampai. Mungkin.",
"story.story_unlock_mawar.06": "Tapi di dermaga ada pelelangan ikan.",
"story.story_unlock_mawar.07": "Untuk pemilik kapal. Dan juru lelangnya pingsan kalau ikannya ngajak berantem.",
"story.story_unlock_mawar.08": "Ikan saya selalu ngajak berantem.",
"story.story_unlock_mawar.09": "Saya tahu. Makanya kamu jual ke saya.",
"story.story_unlock_mawar.10": "Cuma Ibu yang nggak keberatan.",
"story.story_unlock_mawar.11": "Saya keberatan. Cuma nggak pingsan. Beli joran laut dulu saja.",
"story.story_unlock_mawar.12": "TEMPAT BARU: DERMAGA MAWAR",
"story.story_unlock_mawar.13": "Beli Joran Laut di warung. Tahan senar saat ombak datang.",
"duel.silat": "Silat Kali",
"duel.tambang": "Tarik Tambang",
"duel.gasing": "Adu Gasing",
"duel.pinang": "Panjat Pinang",
"duel.silat.upper": "SILAT KALI",
"duel.tambang.upper": "TARIK TAMBANG",
"duel.gasing.upper": "ADU GASING",
"duel.pinang.upper": "PANJAT PINANG",
"howto.tab.silat": "SILAT KALI",
"howto.tab.tambang": "TARIK TAMBANG",
"howto.tab.gasing": "ADU GASING",
"howto.tab.pinang": "PANJAT PINANG",
"howto.tab.travel": "PERJALANAN",
"howto.body.silat": "Ikan memperagakan rangkaian jurus.\nUlangi dengan urutan yang sama memakai empat panah.\nKalau benar, kamu membalas.\nSalah jurus atau kehabisan waktu, kamu yang kena.\nTiga balasan memenangkan duel.",
"howto.body.tambang": "Penanda berayun di sepanjang bar.\nKetuk TARIK saat penanda di zona hijau.\nMenarik di luar zona bikin kamu terpeleset.\nIkan terus menarik sepanjang waktu.\nTarik tali melewati garismu untuk menang.",
"howto.body.gasing": "Ketuk sekali untuk membidik dan sekali untuk tenaga.\nLemparan lurus dan kuat berputar paling lama.\nSaat gasing beradu, ketuk ketika lingkaran menutup.\nKetukan yang pas menghantam lebih keras.\nGasing yang terakhir berputar menang.",
"howto.body.pinang": "Ketuk KIRI dan KANAN bergantian untuk memanjat.\nSisi yang sama dua kali bikin merosot.\nTerlalu cepat bikin tiangnya licin.\nJaga ritme tetap stabil.\nSiapa duluan sampai puncak, dia menang.",
"howto.body.travel": "Tempat baru terbuka seiring utang terbayar.\nBeli perlengkapan tiap tempat di warung, lalu ketuk peta di tepi air.\nSetiap tempat punya ikan dan duel sendiri.\nPenjualan selalu di warung.",
"silat.intro.subtitle": "SILAT KALI. TIGA BALASAN.",
"tambang.intro.subtitle": "TARIK TAMBANG",
"gasing.intro.subtitle": "ADU GASING",
"pinang.intro.subtitle": "PANJAT PINANG. SIAPA CEPAT SAMPAI PUNCAK.",
"silat.tutorial": "PERHATIKAN JURUSNYA, LALU ULANGI",
"tambang.tutorial": "KETUK TARIK DI ZONA HIJAU",
"gasing.tutorial": "KETUK UNTUK BIDIK, KETUK LAGI UNTUK TENAGA",
"pinang.tutorial": "KIRI, KANAN, KIRI, KANAN. STABIL.",
