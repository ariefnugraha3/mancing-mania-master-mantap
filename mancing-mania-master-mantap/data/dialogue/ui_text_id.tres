"result.detail.win": "{fish} MASUK EMBER",
"story.story_prologue_zero.02": "TOTAL UTANG: Rp 2.000.000",
"story.story_prologue_zero.03": "CEPATCASH — PENGINGAT PEMBAYARAN",
"story.story_prologue_zero.04": "Tunggakan Anda masih menunggak.\nKekecewaan kami juga ikut menunggak.",
"story.story_prologue_zero.05": "...Wajar sih.",
"story.story_prologue_zero.23": "Tapi uang aku tinggal sepuluh ribu.",
"story.story_prologue_zero.06": "Aku berangkat ke pabrik dulu.",
"story.story_prologue_zero.07": "Iya, hati-hati.",
"story.story_prologue_zero.08": "Kamu buka aplikasi itu lagi?",
"story.story_prologue_zero.09": "Nggak kok.",
"story.story_prologue_zero.10": "Udah aku hapus semua.",
"story.story_prologue_zero.11": "Bagus.",
"story.story_prologue_zero.12": "Kalau cuma ngehapus saja sih gampang.",
"story.story_prologue_zero.13": "Iya, Aku tahu.",
"story.story_prologue_zero.14": "Ada nasi di rice cooker.",
"story.story_prologue_zero.15": "Oke.",
"story.story_prologue_zero.16": "Rice cooker-nya jangan dijual lagi.",
"story.story_prologue_zero.17": "Itu kan cuma pernah sekali.",
"story.story_prologue_zero.18": "Makanya aku bilang lagi.",
"story.story_prologue_zero.19": "Baiklah.",
"story.story_prologue_zero.20": "Nggak ada jalan pintas.",
"story.story_prologue_zero.21": "CATCH AND BRAWL",
"story.story_prologue_zero.22": "MINGGU — 15.17",
"story.story_first_fish.01": "Turunkan aku.",
"story.story_first_fish.02": "...Hah?",
"story.story_first_fish.03": "Kau tuli? Aku bilang turunkan aku!",
"story.story_first_fish.04": "Ikan kok bisa ngomong?!",
"story.story_first_fish.05": "Kamu sendiri kenapa bisa menganggur?",
"story.story_first_fish.06": "Gak sopan banget.",
"story.story_first_fish.07": "Ayo berantem aja.",
"story.story_first_market.01": "Ikannya masih seger?",
"story.story_first_market.02": "Banget.",
"story.story_first_market.03": "Masih bisa gerak?",
"story.story_first_market.04": "Secara emosional sih iya.",
"story.story_first_market.05": "Taruh aja di timbangan.",
"story.story_first_market.06": "Lebih banyak dari yang saya kira.",
"story.story_first_market.07": "Ya jangan banyak berharap. Gak bagus.",
"story.story_first_market.08": "Satu cicilan beres.",
"story.story_first_market.09": "Tinggal satu juta tujuh ratus sembilan puluh ribu lagi.",
"story.story_first_market.10": "...Nggak usah disebut lengkap gitu, Bu.",
"story.story_first_market.11": "Kamu kelihatan terlalu santai.",
"story.story_debt_100k.01": "DIBAYAR: Rp 100.000",
"story.story_debt_100k.02": "Seratus ribu.",
"story.story_debt_100k.03": "Itu cuma angka.",
"story.story_debt_100k.04": "Angka yang lumayan.",
"story.story_debt_100k.05": "Lebih kecil dari dua juta.",
"story.story_debt_100k.06": "Kayaknya gak perlu disebutin deh.",
"story.story_debt_100k.07": "Biar jelas aja.",
"story.story_debt_100k.08": "Gimana danaunya?",
"story.story_debt_100k.10": "Cukup untung buat balik lagi.",
"story.story_debt_100k.12": "Balik ke danau atau balik ke rumah?",
"story.story_debt_100k.14": "Dua-duanya.",
"story.story_debt_100k.16": "Jawaban bagus.",
"story.story_debt_300k.01": "Aku lihat pembayarannya.",
"story.story_debt_300k.03": "Pembayaran bagus atau pembayaran jelek?",
"story.story_debt_300k.05": "Pembayaran itu umumnya bagus, mas Darto.",
"story.story_debt_300k.07": "Cuma ngecek kategorinya aja.",
"story.story_debt_300k.09": "Lanjutkan.",
"story.story_debt_600k.01": "Yah?",
"story.story_debt_600k.02": "Hai. Semua aman?",
"story.story_debt_600k.03": "Kata Ibu, Ayah sekarang mancing.",
"story.story_debt_600k.04": "Ya kurang lebih seperti itu. Tapi, ada yang lain.",
"story.story_debt_600k.05": "Lainnya apa?",
"story.story_debt_600k.06": "Kerja bareng ikan yang agresifnya nggak wajar.",
"story.story_debt_600k.07": "Kata Ibu, ikannya ngajak berantem.",
"story.story_debt_600k.08": "Ibu kayaknya kebanyakan cerita.",
"story.story_debt_600k.09": "Ayah menang?",
"story.story_debt_600k.10": "Sebagian.",
"story.story_debt_600k.11": "Yang paling aneh yang mana?",
"story.story_debt_600k.12": "Ada ikan nila yang menghakimi rutinitas olahraga Ayah.",
"story.story_debt_600k.13": "Dicatat dong.",
"story.story_debt_600k.14": "Hinaannya?",
"story.story_debt_600k.15": "Semuanya.",
"story.story_debt_600k.16": "Terus kirim fotonya kalau Ayah dapat yang emas.",
"story.story_debt_600k.17": "Kamu tahu soal yang itu?",
"story.story_debt_600k.18": "Udah banyak berseliweran di internet, Yah.",
"story.story_debt_600k.19": "Benar juga. Sekolah asrama punya teknologi canggih.",
"story.story_debt_600k.20": "Canggih banget. Di sini juga ada kursi sama meja.",
"story.story_debt_600k.21": "Pamer banget sih.",
"story.story_debt_600k.22": "BUKU IKAN TERBUKA",
"story.story_debt_600k.23": "Catat untuk Nisa. Dan, rupanya, untuk ilmu pengetahuan.",
"story.story_debt_1000k.01": "Kamu udah lewat setengah jalan.",
"story.story_debt_1000k.02": "Iya, aku sadar.",
"story.story_debt_1000k.03": "Biasanya kamu menghindar kalau lihat angka.",
"story.story_debt_1000k.04": "Aku lagi coba hobi baru.",
"story.story_debt_1000k.05": "Melihat angka?",
"story.story_debt_1000k.06": "Ngeberesin sesuatu.",
"story.story_debt_1000k.07": "Kalau itu udah beres...",
"story.story_debt_1000k.08": "Atap di dapur masih bocor.",
"story.story_debt_1000k.09": "Romantis.",
"story.story_debt_1000k.10": "Aku serius.",
"story.story_debt_1000k.11": "Aku tahu.",
"story.story_debt_1000k.12": "Maksud aku abis bayar hutang itu, mas Darto.",
"story.story_debt_1000k.13": "Iya.",
"story.story_debt_1000k.14": "Paham kok paham.",
"story.story_debt_1400k.01": "Bapak yang punya rumah makan itu nanyain ikanmu lagi.",
"story.story_debt_1400k.02": "Yang mobil boks putih itu?",
"story.story_debt_1400k.03": "Iya.",
"story.story_debt_1400k.04": "Terus gimana?",
"story.story_debt_1400k.05": "Dia bayar.",
"story.story_debt_1400k.06": "Informasi yang luar biasa jelas.",
"story.story_debt_1400k.07": "Dia mau pasokan rutin kalau kamu terus bawa ikan yang layak.",
"story.story_debt_1400k.08": "Rutin?",
"story.story_debt_1400k.09": "Iya, kan barusan saya bilang begitu.",
"story.story_debt_1400k.10": "Kayak... kerja?",
"story.story_debt_1400k.11": "Nggak usah sok dramatis. Bawa ikan aja.",
"story.story_debt_1400k.12": "Siap.",
"story.story_debt_1400k.13": "Ikan seger.",
"story.story_debt_1400k.14": "Secara emosional?",
"story.story_debt_1400k.15": "Terserah.",
"story.story_debt_1650k.01": "SISA UTANG: Rp 150.000",
"story.story_debt_1650k.02": "Hampir.",
"story.story_debt_1650k.03": "Danaunya masih kelihatan sama.",
"story.story_debt_1650k.04": "Bagus.",
"story.story_arowana_first_win.01": "Nikmati kemenanganmu.",
"story.story_arowana_first_win.02": "Memang mau saya nikmati.",
"story.story_arowana_first_win.03": "Danau ini akan mengingatnya.",
"story.story_arowana_first_win.04": "Nggak masalah.",
"story.story_arowana_first_win.05": "Danaunya bayar tiga ratus ribu nggak?",
"story.story_arowana_first_win.06": "Kamu menyebalkan.",
"story.story_arowana_first_win.07": "Berarti iya.",
"story.story_debt_paid.01": "SISA UTANG: Rp 0",
"story.story_debt_paid.02": "CEPATCASH",
"story.story_debt_paid.03": "TAGIHAN ANDA SUDAH LUNAS SEPENUHNYA.",
"story.story_debt_paid.04": "CEPATCASH",
"story.story_debt_paid.05": "Terima kasih.",
"story.story_debt_paid.06": "...Udah, gitu aja?",
"story.story_debt_paid.07": "Nggak ada bos terakhir?",
"story.story_debt_paid.08": "Bagus deh.",
"story.story_debt_paid.09": "Aku lihat.",
"story.story_debt_paid.11": "Udah beres.",
"story.story_debt_paid.13": "Pulang kalau urusan kamu di sana sudah selesai.",
"story.story_debt_paid.15": "Sebentar lagi.",
"story.story_debt_paid.17": "Yaudah iya.",
"story.story_final_family.01": "Jadi yang mana yang ninju Ayah?",
"story.story_final_family.02": "Si lele.",
"story.story_final_family.03": "Ayah kalah {catfish_losses} kali.",
"story.story_final_family.04": "Kenapa malah dibikin statistik?",
"story.story_final_family.05": "Demi ilmu pengetahuan dong.",
"story.story_final_family.06": "Ilmu pengetahuan sekarang suka menghakimi juga ya.",
"story.story_final_family.07": "Ayah nulis kalau si nila bilang postur Ayah lemah.",
"story.story_final_family.08": "Catatan yang akurat itu penting.",
"story.story_final_family.09": "Postur kamu memang lemah, mas.",
"story.story_final_family.10": "Keluarga ini kayaknya penuh ceplas-ceplos ya.",
"story.story_final_family.11": "Ayah masih mau ke sini?",
"story.story_final_family.12": "Kayaknya.",
"story.story_final_family.13": "Ayah memang suka dibentak-bentak ikan.",
"story.story_final_family.14": "Ayah suka bagian yang tenangnya.",
"story.story_final_family.15": "Dan uangnya.",
"story.story_final_family.16": "Dan sebagian uangnya.",
"story.story_final_family.17": "Jangan cari ribut lagi.",
"story.story_final_family.18": "Aku nggak pernah mulai duluan.",
"story.story_final_family.19": "ITU BOHONG.",
"story.story_postgame_unlock.01": "MODE MANCING BEBAS TERBUKA",
"story.story_postgame_unlock.02": "Utangnya sudah hilang.\nIkan-ikannya sayangnya masih di sini.",
"story.story_postgame_unlock.03": "BUKU UTANG sekarang jadi TABUNGAN KELUARGA.",
"story.story_postgame_unlock.04": "Terus mancing, lengkapi Buku Ikan, upgrade peralatan, kejar rekor, atau cukup duduk di tepi danau sebentar.",
"story.story_postgame_unlock.05": "KEMBALI KE DANAU",
"credits.01": "CATCH AND BRAWL",
"credits.02": "Game yang sangat serius tentang ikan-ikan yang sangat tidak serius.",
