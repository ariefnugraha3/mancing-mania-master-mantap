"fishing.event.bird.1": "Dia bahkan nggak butuh joran.",
"fishing.event.bird.2": "Sisain buat saya.",
"fishing.event.bird.3": "Profesional.",
"fishing.event.gull.1": "Pencuri!",
"fishing.event.gull.2": "Bayar dulu itu!",
"fishing.event.gull.3": "Burung di sini juga nggak punya sopan santun!",
"fishing.event.frog.croak": "Kung kong.",
"fishing.event.frog.1": "Nggak ada yang nanya ya, katak.",
"fishing.event.frog.2": "Terima kasih.",
"fishing.event.dragonfly.1": "Bukan ikan. Bukan ikan.",
"fishing.event.dragonfly.2": "Turun dari pelampung saya.",
"fishing.event.dragonfly.3": "Kalau ikannya kabur, kamu yang bayar.",
"fishing.event.sandal.1": "Ada yang pulang pakai sandal cuma sebelah.",
"fishing.event.sandal.2": "Hari ini jangan sandal. Jangan hari ini.",
"fishing.event.sandal.3": "Sepertinya yang itu pernah saya tangkap.",
"fishing.event.bottle.spotted": "Ada botol! Ambil sebelum hanyut.",
"fishing.event.bottle.missed": "...Dan hanyut.",
"fishing.event.bottle.title": "PESAN DALAM BOTOL",
"fishing.event.bottle.cash": "Tergulung di dalamnya: {amount}. Rezeki nggak ke mana.",
"fishing.event.bottle.note.1": "\"Utang Rp 50.000. Tertanda, danau.\"",
"fishing.event.bottle.note.2": "\"Siapa pun yang menemukan ini: si lele curang.\"",
"fishing.event.bottle.note.3": "\"Peta harta karun.\" Isinya gambar ikan.",
"fishing.event.bottle.note.4": "\"Jangan menyerah. Dari orang yang juga pernah ngutang.\"",
"fishing.event.family.title": "PESAN DARI {name}",
"fishing.event.family.early.1": "Ayah, jangan lupa makan ya.",
"fishing.event.family.early.2": "Rice cooker masih di rumah kan? Bagus.",
"fishing.event.family.early.3": "Bawa pulang yang besar ya!",
"fishing.event.family.mid.1": "Kata Bu Yati, kamu pelanggan terbaik dia. Itu pujian ya?",
"fishing.event.family.mid.2": "Guru tanya Ayah kerja apa. Aku jawab: berantem sama ikan.",
"fishing.event.family.mid.3": "Atap masih bocor. Cuma ngasih tau aja sih.",
"fishing.event.family.late.1": "Sedikit lagi. Pulang sebelum gelap.",
"fishing.event.family.late.2": "Aku bilang ke teman-teman, Ayah juara mancing.",
"fishing.event.family.late.3": "Aku bangga sama kamu, mas. Jangan aneh-aneh ya.",
"fishing.event.family.free.1": "Utang lunas, alasan habis. Bawa ikan buat makan malam.",
"fishing.event.family.free.2": "Minggu boleh ikut mancing?",
"fishing.event.family.free.3": "Nisa minta layangan. Bukan ikan ya. Layangan.",
"fishing.event.drizzle.1": "Ikan suka gerimis katanya.",
"fishing.event.drizzle.2": "Mandi gratis.",
"fishing.event.drizzle.3": "Nanti Rini bilang harusnya bawa payung.",
"fishing.event.motor.1.them": "Oi, Darto! Dapat apa?",
"fishing.event.motor.1.darto": "Harapan. Kebanyakan harapan.",
"fishing.event.motor.2.them": "Mancing di hari kerja?",
"fishing.event.motor.2.darto": "Kalau punya utang, tiap hari itu adalah hari kerja.",
"fishing.event.motor.3.them": "Salam buat Bu Yati ya!",
"fishing.event.motor.3.darto": "Nanti saya malah ditagih hutang.",
"fishing.event.kites.1.them": "Pak Darto! Lihat, layangan kami terbang!",
"fishing.event.kites.1.darto": "Bagus. Jauh-jauh dari senar saya ya.",
"fishing.event.kites.2.them": "Itu ikan atau sandal, Pak?",
"fishing.event.kites.2.darto": "Jangan tanya.",
"fishing.event.kites.3.them": "Layangan kami lebih tinggi dari ikan Bapak!",
"fishing.event.kites.3.darto": "Semuanya lebih tinggi dari ikan saya.",
"speaker.collector": "PENAGIH",
"speaker.duck": "BEBEK",
"speaker.cat": "KUCING",
"fishing.event.heckle.1.them": "Itu umpan? Serius?",
"fishing.event.heckle.1.darto": "Lagi diskon.",
"fishing.event.heckle.2.them": "Aku lagi diet. Coba lagi besok.",
"fishing.event.heckle.2.darto": "Saya juga. Terpaksa.",
"fishing.event.heckle.3.them": "Pelampungnya miring.",
"fishing.event.heckle.3.darto": "Kayak hidup saya.",
"fishing.event.heckle.4.them": "Kata sepupuku, kamu dipukuli lele.",
"fishing.event.heckle.4.darto": "Sepupu kamu kebanyakan ngomong.",
"fishing.event.collector.1.them": "Pak Darto? Pengingat ramah dari CepatCash!",
"fishing.event.collector.1.darto": "(berdiri diam, pura-pura jadi orang-orangan sawah)",
"fishing.event.collector.1.them2": "...Cuma orang-orangan sawah. Aneh juga di sini kok ada orang-orangan sawah.",
"fishing.event.collector.2.them": "Pak! Cicilan Bapak jatuh tempo!",
"fishing.event.collector.2.darto": "Darto sudah pindah. Jauh. Ke danau lain.",
"fishing.event.collector.2.them2": "Oke! Salam buat dia ya!",
"fishing.event.collector.3.them": "Bunga tidak menunggu siapa-siapa, Pak!",
"fishing.event.collector.3.darto": "Ikan juga gitu.",
"fishing.event.collector.3.them2": "Haha! Lucu, Pak. Tapi tetap bayar ya.",
"fishing.event.collector.free.them": "Pak Darto! Mau pinjam lagi? Bunga super rendah!",
"fishing.event.collector.free.darto": "Tidak. Tidak lagi. Tidak akan lagi.",
"fishing.event.collector.free.them2": "Minggu depan kami mampir lagi ya!",
"fishing.event.ducks.quack": "Kwek. Kwek.",
"fishing.event.ducks.late": "KWEK! Kwek kwek kwek!",
"fishing.event.ducks.1": "Bebek saja keluarganya lebih tertata.",
"fishing.event.ducks.2": "Mereka berenang berbaris. Saya lempar kail saja nggak lurus.",
"fishing.event.ducks.3": "Cepat, kecil. Hidup nggak butuh uang.",
