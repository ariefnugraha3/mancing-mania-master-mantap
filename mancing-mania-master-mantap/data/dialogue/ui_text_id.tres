"settings.rhythm.calibrate": "KALIBRASI RITME",
"calibration.title": "KALIBRASI RITME",
"calibration.body": "Ketuk tombol apa saja atau layar di setiap bunyi klik. Dua ketukan pertama cuma pemanasan.",
"calibration.preparing": "Menyiapkan bunyi klik...",
"calibration.tap": "IKUTI KETUKANNYA",
"calibration.count": "{count} / {total}",
"calibration.too_few": "Ketukannya kurang. Coba lagi?",
"calibration.result": "Offset yang disarankan: {ms} ms",
"calibration.result_body": "Terima, coba lagi, atau atur sendiri di Pengaturan.",
"calibration.accept": "TERIMA",
"calibration.retry": "COBA LAGI",
"speaker.darto": "DARTO",
"dialogue.catfish_bruiser.land.1": "Bukan urusan pribadi, Bos. Bisnis ya bisnis.",
"dialogue.catfish_bruiser.land.2": "Kita bisa selesaikan baik-baik. Yaitu pakai kekerasan.",
"dialogue.catfish_bruiser.land.3": "Kamu lagi? Ya sudah. Angkat tanganmu.",
"dialogue.catfish_bruiser.land.4": "Sore ini aku sudah ada acara. Sekarang aku harus meninjumu.",
"dialogue.catfish_bruiser.player_win.1": "Adil. Ember itu pantas mendapatkan aku.",
"dialogue.catfish_bruiser.player_win.2": "Pukulan bagus. Jangan dibawa perasaan.",
"dialogue.catfish_bruiser.player_win.3": "Bilang ke siapapun yang beli aku, aku kalah secara profesional.",
"dialogue.catfish_bruiser.player_win.4": "Aku kagum sama usahamu. Sama embernya nggak.",
"dialogue.catfish_bruiser.fish_win.1": "Bilang ke embermu: aku nolak.",
"dialogue.catfish_bruiser.fish_win.2": "Usahanya bagus. Hasilnya parah.",
"dialogue.catfish_bruiser.fish_win.3": "Bukan urusan pribadi. Aku lebih suka danau.",
"dialogue.catfish_bruiser.fish_win.4": "Balik lagi kalau langkah kakimu sudah berhenti minta maaf.",
"dialogue.catfish_bruiser.reel_escape.1": "Kebanyakan tegang, Bos!",
"dialogue.catfish_bruiser.reel_escape.2": "Senarmu menyerah duluan sebelum aku.",
"dialogue.catfish_bruiser.reel_escape.3": "Anggap saja itu peringatan.",
"dialogue.tilapia_gym_rat.land.1": "Set pemanasan beres. Sekarang kita duel.",
"dialogue.tilapia_gym_rat.land.2": "Aku hitung tarikanmu. Volumenya mengecewakan.",
"dialogue.tilapia_gym_rat.land.3": "Mantap. Latihan beban datang sendiri.",
"dialogue.tilapia_gym_rat.land.4": "Minum dulu. Habis itu siap-siap kalah.",
"dialogue.tilapia_gym_rat.player_win.1": "Tekniknya solid. Gaya hidupnya meragukan.",
"dialogue.tilapia_gym_rat.player_win.2": "Balasan tadi formnya bagus. Respek.",
"dialogue.tilapia_gym_rat.player_win.3": "Oke. Ternyata hari ini leg day.",
"dialogue.tilapia_gym_rat.player_win.4": "Embernya harus ada proteinnya.",
"dialogue.tilapia_gym_rat.fish_win.1": "HARI PEMULIHAN!",
"dialogue.tilapia_gym_rat.fish_win.2": "Teknikmu ambruk duluan sebelum ototku.",
"dialogue.tilapia_gym_rat.fish_win.3": "Latihan lebih keras. Tarik lebih rapi.",
"dialogue.tilapia_gym_rat.fish_win.4": "Ini kucatat sebagai kardio.",
"dialogue.tilapia_gym_rat.reel_escape.1": "Kekuatan genggaman! Latih lagi!",
"dialogue.tilapia_gym_rat.reel_escape.2": "Senarnya gagal menyelesaikan set!",
"dialogue.tilapia_gym_rat.reel_escape.3": "Beban bertahap, bro! Bukan beban hidup!",
"dialogue.gourami_shady.land.1": "Pertemuan ini tidak ada di jadwal.",
"dialogue.gourami_shady.land.2": "Kita bisa selesaikan ini tanpa berkas-berkas.",
"dialogue.gourami_shady.land.3": "Aku punya teman di perairan yang lebih dalam.",
"dialogue.gourami_shady.land.4": "Apa pun yang terjadi nanti, kamu tidak pernah dengar namaku.",
"dialogue.gourami_shady.player_win.1": "Sayang sekali. Jangan dicatat ya.",
"dialogue.gourami_shady.player_win.2": "Aku dan ember ini tidak pernah bertemu.",
"dialogue.gourami_shady.player_win.3": "Tolong dicatat bahwa transaksi ini masih disengketakan.",
"dialogue.gourami_shady.player_win.4": "Baik. Tapi aku tidak pernah ada di sini.",
"dialogue.gourami_shady.fish_win.1": "Tidak ada saksi. Sempurna.",
"dialogue.gourami_shady.fish_win.2": "Urusan kita selesai.",
"dialogue.gourami_shady.fish_win.3": "Sebaiknya kamu lupakan wajahku.",
"dialogue.gourami_shady.fish_win.4": "Danau ini punya pengacara yang sangat bagus.",
"dialogue.gourami_shady.reel_escape.1": "Barang bukti dimusnahkan.",
"dialogue.gourami_shady.reel_escape.2": "Senar lepas. Jejak lepas. Prinsipnya sama.",
"dialogue.gourami_shady.reel_escape.3": "Kamu tidak bisa membuktikan itu aku.",
"dialogue.carp_golden.land.1": "Anda boleh mengagumi saya sebentar sebelum kalah.",
"dialogue.carp_golden.land.2": "Jangan sampai sisik saya kusut.",
"dialogue.carp_golden.land.3": "Tadinya sore saya ini sore premium.",
"dialogue.carp_golden.land.4": "Lancang sekali senar pancing itu.",
"dialogue.carp_golden.player_win.1": "Ini memalukan secara ekonomi.",
"dialogue.carp_golden.player_win.2": "Taruh sesuatu yang empuk di ember itu.",
"dialogue.carp_golden.player_win.3": "Saya minta transportasi kelas premium.",
"dialogue.carp_golden.player_win.4": "Anda menang. Tapi pakaian Anda tetap memprihatinkan.",
"dialogue.carp_golden.fish_win.1": "Sudah saya duga. Kemewahan kembali ke air.",
"dialogue.carp_golden.fish_win.2": "Kekayaan bersih dan rasio menang Anda sama-sama konsisten.",
"dialogue.carp_golden.fish_win.3": "Lambaikan tangan kalau saya lewat di depan motor Anda.",
"dialogue.carp_golden.fish_win.4": "Ada hal-hal yang memang tidak terjangkau.",
"dialogue.carp_golden.reel_escape.1": "Senar murahan. Sudah ketebak.",
"dialogue.carp_golden.reel_escape.2": "Itu bukan manajemen tegangan kelas premium.",
"dialogue.carp_golden.reel_escape.3": "Pertimbangkan peralatan yang bermartabat.",
"dialogue.snakehead_sergeant.land.1": "SIKAP SEMPURNA! PANDANGAN KE DEPAN! SIAP!",
"dialogue.snakehead_sergeant.land.2": "ITU YANG KAMU SEBUT MENDARATKAN? ULANG!",
"dialogue.snakehead_sergeant.land.3": "DISIPLIN DIMULAI SAAT KENYAMANAN BERAKHIR!",
"dialogue.snakehead_sergeant.land.4": "KAMU MEMASUKI PERAIRAN TEMPUR!",
"dialogue.snakehead_sergeant.player_win.1": "PENAMPILAN BISA DITERIMA! NYARIS!",
"dialogue.snakehead_sergeant.player_win.2": "KEKALAHAN DITERIMA! LANJUTKAN!",
"dialogue.snakehead_sergeant.player_win.3": "BALASAN BAGUS! SANDALNYA PARAH!",
"dialogue.snakehead_sergeant.player_win.4": "EMBER INI SEKARANG POS JAGAKU!",
"dialogue.snakehead_sergeant.fish_win.1": "KEMBALI LATIHAN!",
"dialogue.snakehead_sergeant.fish_win.2": "MISI GAGAL, PEMANCING!",
"dialogue.snakehead_sergeant.fish_win.3": "DANAU TETAP MENGUASAI POSISI INI!",
"dialogue.snakehead_sergeant.fish_win.4": "DISIPLIN: MILIKKU. MAKAN MALAM: BUKAN MILIKMU.",
"dialogue.snakehead_sergeant.reel_escape.1": "SENAR GAGAL BERTAHAN!",
"dialogue.snakehead_sergeant.reel_escape.2": "MANAJEMEN TEGANGAN: TIDAK MEMUASKAN!",
"dialogue.snakehead_sergeant.reel_escape.3": "SUSUN BARISAN DAN LEMPAR LAGI!",
"dialogue.arowana_don.land.1": "Kita bertemu lagi. Danau ini punya selera humor.",
"dialogue.arowana_don.land.2": "Kesabaran membawamu ke sini. Mari kita lihat apa yang bisa dilakukan keahlian.",
"dialogue.arowana_don.land.3": "Kamu jadi gigih. Aku menghormati kegigihan.",
"dialogue.arowana_don.land.4": "Jangan kira kelangkaan itu keberuntungan, Darto.",
"dialogue.arowana_don.player_win.1": "Kemenangan yang bersih. Jangan jadi sombong.",
"dialogue.arowana_don.player_win.2": "Kamu sudah berkembang. Diam-diam. Itu lebih baik.",
"dialogue.arowana_don.player_win.3": "Ambil uangmu. Danau ini akan selamat dari penghinaan ini.",
"dialogue.arowana_don.player_win.4": "Konsisten itu sifat yang menyebalkan. Pertahankan.",
"dialogue.arowana_don.fish_win.1": "Bukan hari ini, Darto.",
"dialogue.arowana_don.fish_win.2": "Kamu hampir. Tapi hampir itu masih di dalam air.",
"dialogue.arowana_don.fish_win.3": "Danau menyimpan apa yang tidak bisa kamu selesaikan.",
"dialogue.arowana_don.fish_win.4": "Kembalilah saat kesabaranmu lebih berat dari penyesalanmu.",
"dialogue.arowana_don.reel_escape.1": "Kamu menarik terlalu keras. Hidup belum mengajarimu apa-apa?",
"dialogue.arowana_don.reel_escape.2": "Sabar, Darto. Senar pun tahu batasnya.",
"dialogue.arowana_don.reel_escape.3": "Danau ini tidak pernah kalah oleh ketidaksabaran.",
"dialogue.darto.after_win.1": "Masuk ember. Tolong jangan dimasukkan ke hati.",
"dialogue.darto.after_win.2": "Nggak nyangka ini sekarang dihitung kerja.",
"dialogue.darto.after_win.3": "Bagus. Bu Yati bakal nanya-nanya lagi.",
"dialogue.darto.after_win.4": "Satu ikan lebih dekat. Itu cukup.",
"dialogue.darto.after_loss.1": "Ya jelas dia bisa berantem. Ya jelas dia bisa menang.",
"dialogue.darto.after_loss.2": "Orang rumah nggak perlu tahu soal tadi.",
"dialogue.darto.after_loss.3": "Ya sudah. Berikutnya.",
"dialogue.darto.after_loss.4": "Saya ke sini niatnya santai. Kesalahan besar.",
"dialogue.darto.after_reel_escape.1": "Kekencengan. Salah saya.",
"dialogue.darto.after_reel_escape.2": "Pelan-pelan, Darto. Itu ikan, bukan debt collector.",
"dialogue.darto.after_reel_escape.3": "Karier senar itu lebih pendek dari dugaan saya.",
"dialogue.advance": "KETUK UNTUK LANJUT",
