"travel.title": "MAU KE MANA?",
"travel.here": "KAMU DI SINI",
"travel.go": "BERANGKAT",
"travel.locked_debt": "Terbuka setelah {amount} utang terbayar.",
"travel.locked_event": "Terbuka di kunjunganmu berikutnya ke warung.",
"travel.need_gear": "Beli {gear} di warung dulu.",
"travel.fish_count": "Buku Ikan: {count} / {total}",
"travel.locked_name": "???",
"fishing.tide.high": "PASANG",
"fishing.tide.low": "SURUT",
"market.gear.title": "PERLENGKAPAN JALAN",
"market.gear.buy": "BELI  {price}",
"market.gear.owned": "SUDAH PUNYA",
"market.gear.locked": "Terbuka bersama {location}.",
"market.book.legend": "LEGENDA",
"market.book.spot_locked": "Tempat yang belum kamu datangi.",
"tambang.heave_warning": "! IKANNYA PASANG KUDA-KUDA !",
"tambang.heave": "!! TARIK !!",
"gasing.miss": "IKANNYA MENGHANTAM",
"gasing.early": "KECEPATAN",
"fishing.hint.travel": "Ada tempat baru! Ketuk peta untuk pindah.",
"pinang.grease_label": "LICIN",
"speaker.neighbour": "TETANGGA",
"speaker.kids": "ANAK-ANAK",
