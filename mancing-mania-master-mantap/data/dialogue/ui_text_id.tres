"credits.14": "Arief Nugraha",
"credits.15": "TERIMA KASIH KHUSUS",
"credits.16": "Semua orang yang pernah menghabiskan Minggu sore di tepi danau.",
"credits.17": "Terima kasih sudah menghabiskan Minggu sore di Danau Cempaka.",
"credits.18": "Tolong jangan berdebat dengan ikan.",
"cepatcash.1.title": "PENGINGAT PEMBAYARAN",
"cepatcash.1.body": "Tunggakan Anda masih menunggak.",
"cepatcash.2.title": "PEMBERITAHUAN AKUN",
"cepatcash.2.body": "Kami menghargai pembayaran terakhir Anda.\nKami akan lebih menghargai sisanya.",
"cepatcash.3.title": "PEMBARUAN SALDO",
"cepatcash.3.body": "Kemajuan terdeteksi.\nAntusiasme masih dibatasi prosedur.",
"cepatcash.4.title": "PENGINGAT RAMAH",
"cepatcash.4.body": "Ini adalah versi ramah dari pengingatnya.",
"cepatcash.5.title": "STATUS PEMBAYARAN",
"cepatcash.5.body": "Masih belum nol.\nSudah kami cek dua kali.",
"cepatcash.darto.1": "Informatif sekali.",
"cepatcash.darto.2": "Makasih, komputer kecil penuh stres.",
"cepatcash.darto.3": "Pelan-pelan asalkan lunas.",
"cepatcash.darto.4": "Saya tahu.",
"banter.1.1": "Ikannya seger?",
"banter.1.2": "Pertanyaan itu sekarang kedengarannya jadi terasa mengancam.",
"banter.2.1": "Ibu pernah libur nggak?",
"banter.2.2": "Ini hari libur saya.",
