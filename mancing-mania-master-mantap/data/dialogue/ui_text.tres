"credits.15": "SPECIAL THANKS",
"credits.16": "Everyone who spent a Sunday afternoon by a lake.",
"credits.17": "Thank you for spending a Sunday afternoon at Cempaka Lake.",
"credits.18": "Please do not argue with the fish.",
"cepatcash.1.title": "PAYMENT REMINDER",
"cepatcash.1.body": "Your outstanding balance remains outstanding.",
"cepatcash.2.title": "ACCOUNT NOTICE",
"cepatcash.2.body": "We appreciate your recent payment.\nWe would appreciate the rest more.",
"cepatcash.3.title": "BALANCE UPDATE",
"cepatcash.3.body": "Progress detected.\nEnthusiasm remains procedurally limited.",
"cepatcash.4.title": "FRIENDLY REMINDER",
"cepatcash.4.body": "This is the friendly version of the reminder.",
"cepatcash.5.title": "PAYMENT STATUS",
"cepatcash.5.body": "Still not zero.\nWe checked twice.",
"cepatcash.darto.1": "Very informative.",
"cepatcash.darto.2": "Thank you, tiny rectangle of stress.",
"cepatcash.darto.3": "We're getting there.",
"cepatcash.darto.4": "I know.",
"banter.1.1": "Fish fresh?",
"banter.1.2": "That question has become threatening.",
"banter.2.1": "Do you ever take a day off?",
"banter.2.2": "This is my day off.",
"banter.2.3": "You are at work.",
"banter.2.4": "Quietly.",
"banter.3.1": "You caught another sandal.",
"banter.3.2": "The lake provides.",
"banter.3.3": "The lake needs cleaning.",
