"privacy.title": "PRIVACY",
"privacy.summary.1": "NO ACCOUNT REQUIRED",
"privacy.summary.2": "NO ADS",
"privacy.summary.3": "NO ANALYTICS",
"privacy.summary.4": "NO PERSONAL DATA COLLECTION BY THE GAME",
"privacy.summary.5": "SAVE DATA STAYS ON THIS DEVICE/BROWSER",
"privacy.read_full": "READ FULL PRIVACY POLICY",
"privacy.licenses": "ENGINE LICENSES",
"privacy.policy.intro": "Mancing Mania: Gelut Edition is designed to be played without creating an account and without sending gameplay data to the developer.",
"privacy.policy.collection.title": "Data collection",
"privacy.policy.collection.body": "The game does not collect, sell, or share personal information. It does not use advertising SDKs, analytics SDKs, tracking SDKs, location services, camera access, microphone access, contacts, or social login.",
"privacy.policy.local.title": "Local save data",
"privacy.policy.local.body": "Game progress, settings, records, Fish Book progress, and story progress are stored locally on your device or, for the web version, in browser storage. This information is not transmitted by the game to a developer server.",
"privacy.policy.web.title": "Web version",
"privacy.policy.web.body": "The web version is hosted by a third-party distribution platform. That platform may process technical information under its own privacy policy when delivering the game files. Mancing Mania: Gelut Edition does not add its own analytics, advertising, or tracking system.",
"privacy.policy.export.title": "Save export and import",
"privacy.policy.export.body": "If the web build provides manual save export, the save file is created only when you request it. Import reads the file you choose locally in order to restore game progress.",
"privacy.policy.children.title": "Children and personal information",
"privacy.policy.children.body": "The game does not ask players to provide personal information and does not provide chat, user-generated content, or account features.",
"privacy.policy.changes.title": "Changes to this policy",
"privacy.policy.changes.body": "If a future version adds any feature that changes how data is handled, this policy will be updated before that version is released.",
"privacy.policy.contact.title": "Contact",
"privacy.policy.contact.body": "For privacy or support questions, contact: [PUBLISHER SUPPORT EMAIL]",
"privacy.licenses.intro": "Made with the Godot Engine. Godot is free and open source software under the MIT license:",
"privacy.licenses.components": "Godot includes third-party components under their own licenses: {list}.",
"settings.web_storage_note": "This web version keeps your save in this browser's storage. Clearing site data or browser storage deletes it."
})
