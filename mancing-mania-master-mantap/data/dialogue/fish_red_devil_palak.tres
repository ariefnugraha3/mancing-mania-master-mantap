[sub_resource type="Resource" id="Entry_3"]
script = ExtResource("2_entry")
speaker_id = &"red_devil_palak"
text = "Public, sure. Safe? That costs extra."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_4"]
script = ExtResource("2_entry")
speaker_id = &"darto"
text = "I already have a debt collector."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_5"]
script = ExtResource("2_entry")
speaker_id = &"red_devil_palak"
text = "Then you know how this goes."
