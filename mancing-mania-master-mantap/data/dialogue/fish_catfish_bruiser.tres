[gd_resource type="Resource" script_class="DialogueSequence" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/data/dialogue_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://scripts/gameplay/data/dialogue_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="Entry_1"]
script = ExtResource("2_entry")
speaker_id = &"catfish_bruiser"
text = "Put me down."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_2"]
script = ExtResource("2_entry")
speaker_id = &"darto"
text = "...What?"
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_3"]
script = ExtResource("2_entry")
speaker_id = &"catfish_bruiser"
text = "You heard me."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_4"]
script = ExtResource("2_entry")
speaker_id = &"darto"
text = "Fish don't talk."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_5"]
script = ExtResource("2_entry")
speaker_id = &"catfish_bruiser"
text = "And unemployed men don't usually argue with dinner."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_6"]
script = ExtResource("2_entry")
speaker_id = &"catfish_bruiser"
text = "Square up."
post_pause_sec = 0.8

[resource]
script = ExtResource("1_seq")
id = &"fish_catfish_bruiser"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_1"), SubResource("Entry_2"), SubResource("Entry_3"), SubResource("Entry_4"), SubResource("Entry_5"), SubResource("Entry_6")])
