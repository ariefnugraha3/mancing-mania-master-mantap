[gd_resource type="Resource" script_class="DialogueSequence" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/data/dialogue_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://scripts/gameplay/data/dialogue_entry.gd" id="2_entry"]

[sub_resource type="Resource" id="Entry_1"]
script = ExtResource("2_entry")
speaker_id = &"hampala_pembalap"
text = "Nice bike. Is it a museum piece?"
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_2"]
script = ExtResource("2_entry")
speaker_id = &"darto"
text = "It's twenty years old and it runs."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_3"]
script = ExtResource("2_entry")
speaker_id = &"hampala_pembalap"
text = "Barely. I heard it from the bridge."
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_4"]
script = ExtResource("2_entry")
speaker_id = &"darto"
text = "Did you just insult my motorcycle?"
post_pause_sec = 0.4

[sub_resource type="Resource" id="Entry_5"]
script = ExtResource("2_entry")
speaker_id = &"hampala_pembalap"
text = "Race me and find out."
post_pause_sec = 0.4

[resource]
script = ExtResource("1_seq")
id = &"fish_hampala_pembalap"
entries = Array[ExtResource("2_entry")]([SubResource("Entry_1"), SubResource("Entry_2"), SubResource("Entry_3"), SubResource("Entry_4"), SubResource("Entry_5")])
