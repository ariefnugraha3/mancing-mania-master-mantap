[gd_resource type="Resource" script_class="UpgradeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/data/upgrade_data.gd" id="1_upgrade"]

[resource]
script = ExtResource("1_upgrade")
id = &"bucket"
name = "Big Bucket"
max_level = 3
prices = Array[int]([10000, 30000, 70000])
stat_key = &"bucket_capacity_per_level"
effect_per_level = 5.0
effect_unit = "bucket space"
description = "The bucket holds 5 more catches per level: 5, then 10, 15 and 20."
