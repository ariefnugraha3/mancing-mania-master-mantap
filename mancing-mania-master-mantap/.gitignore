# Godot 4+ specific ignores
.godot/
.import/
/android/

# Build / export output (GDD Section 191.6)
export/
build/web/
build/android/
build/itch/
build/store/
build/tmp/
*.apk
*.aab

# Signing material and local secrets - never commit
*.keystore
*.jks
.env
.env.*
# Publisher contact data stays with the owner (GDD 186.10)
release/publisher_metadata.json

# OS noise
.DS_Store
Thumbs.db
